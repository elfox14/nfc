    <!-- Pop-out Sheet: Direct Contact Sheet -->
    <div class="luxury-sheet-backdrop" id="sheet-contact" aria-hidden="true">
        <div class="luxury-sheet" role="dialog" aria-labelledby="sheet-contact-title">
            <div class="sheet-handle"></div>
            <div class="sheet-header">
                <div class="sheet-title-group">
                    <i class="fas fa-phone-alt" style="color:#60a5fa;"></i>
                    <h3 id="sheet-contact-title" class="i18n-sheet-contact-title"><%= (typeof initialLang !== 'undefined' && initialLang === 'en') ? 'Direct Contact' : 'وسائل الاتصال المباشرة' %></h3>
                </div>
                <button class="sheet-close-btn" data-close-sheet="sheet-contact" aria-label="إغلاق">&times;</button>
            </div>

            <!-- Phone Numbers -->
            <% if (safeDynamic.phones) { safeDynamic.phones.forEach(phone => { if (phone && phone.value) { 
                const rawNum = String(phone.value).replace(/\D/g, ''); %>
                <div class="sheet-item-row">
                    <a href="tel:<%= rawNum %>" class="sheet-item-main">
                        <div class="sheet-item-icon" style="background: rgba(59,130,246,0.15); color: #60a5fa;">
                            <i class="fas fa-phone"></i>
                        </div>
                        <div class="sheet-item-text">
                            <span class="sheet-item-label"><%= (typeof initialLang !== 'undefined' && initialLang === 'en') ? 'Phone Call' : 'اتصال هاتفي' %></span>
                            <span class="sheet-item-val" dir="ltr"><%= phone.value %></span>
                        </div>
                    </a>
                    <button class="sheet-copy-btn" data-copy-val="<%= phone.value %>" title="نسخ الرقم" aria-label="نسخ الرقم">
                        <i class="fas fa-copy"></i>
                    </button>
                </div>
            <% }}); } %>

            <!-- WhatsApp Direct -->
            <% if (cleanWa) { %>
                <div class="sheet-item-row">
                    <a href="https://wa.me/<%= cleanWa %>?text=<%= waGreeting %>" target="_blank" rel="noopener noreferrer" class="sheet-item-main">
                        <div class="sheet-item-icon" style="background: rgba(37,211,102,0.15); color: #25d366;">
                            <i class="fab fa-whatsapp"></i>
                        </div>
                        <div class="sheet-item-text">
                            <span class="sheet-item-label">WhatsApp</span>
                            <span class="sheet-item-val" dir="ltr"><%= mainWhatsapp || cleanWa %></span>
                        </div>
                    </a>
                    <button class="sheet-copy-btn" data-copy-val="<%= mainWhatsapp || cleanWa %>" title="نسخ واتساب" aria-label="نسخ واتساب">
                        <i class="fas fa-copy"></i>
                    </button>
                </div>
            <% } %>

            <!-- Email Direct -->
            <% if (mainEmail) { %>
                <div class="sheet-item-row">
                    <a href="mailto:<%= mainEmail %>" class="sheet-item-main">
                        <div class="sheet-item-icon" style="background: rgba(234,67,53,0.15); color: #ea4335;">
                            <i class="fas fa-envelope"></i>
                        </div>
                        <div class="sheet-item-text">
                            <span class="sheet-item-label"><%= (typeof initialLang !== 'undefined' && initialLang === 'en') ? 'Email' : 'البريد الإلكتروني' %></span>
                            <span class="sheet-item-val"><%= mainEmail %></span>
                        </div>
                    </a>
                    <button class="sheet-copy-btn" data-copy-val="<%= mainEmail %>" title="نسخ البريد" aria-label="نسخ البريد">
                        <i class="fas fa-copy"></i>
                    </button>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Pop-out Sheet: Social & Professional Networks -->
    <div class="luxury-sheet-backdrop" id="sheet-social" aria-hidden="true">
        <div class="luxury-sheet" role="dialog" aria-labelledby="sheet-social-title">
            <div class="sheet-handle"></div>
            <div class="sheet-header">
                <div class="sheet-title-group">
                    <i class="fas fa-globe" style="color:#c084fc;"></i>
                    <h3 id="sheet-social-title" class="i18n-sheet-social-title"><%= (typeof initialLang !== 'undefined' && initialLang === 'en') ? 'Professional & Social Networks' : 'الشبكات المهنية والاجتماعية' %></h3>
                </div>
                <button class="sheet-close-btn" data-close-sheet="sheet-social" aria-label="إغلاق">&times;</button>
            </div>

            <div class="social-sheet-grid">
                <% followMethods.forEach(item => { 
                    const platform = platforms[item.type] || { icon: 'fas fa-link', color: '#c5a059', prefix: '' };
                    let url = item.value;
                    if (!url.startsWith('http')) url = 'https://' + url;
                    const displayHandle = item.value.replace(/^(https?:\/\/)?(www\.)?/, '');
                %>
                    <a href="<%= url %>" target="_blank" rel="noopener noreferrer" class="social-sheet-card">
                        <div class="sheet-item-icon" style="background: rgba(255,255,255,0.06); color: <%= platform.color %>;">
                            <i class="<%= platform.icon %>"></i>
                        </div>
                        <div class="sheet-item-text">
                            <span class="sheet-item-label" style="text-transform: capitalize;"><%= item.type %></span>
                            <span class="sheet-item-val"><%= displayHandle %></span>
                        </div>
                    </a>
                <% }); %>
            </div>
        </div>
