                    <h3 id="sheet-bio-title"><%= (typeof initialLang !== 'undefined' && initialLang === 'en') ? 'About Profile' : 'الملف التعريفي والخبرات' %></h3>
                </div>
                <button class="sheet-close-btn" data-close-sheet="sheet-bio" aria-label="إغلاق">&times;</button>
