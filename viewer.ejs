                    </div>
                    <div class="form-group-viewer">
                        <label for="lead-email" class="lead-label i18n-lead-email">البريد الإلكتروني (اختياري)</label>
                        <input type="email" id="lead-email" placeholder="example@email.com" dir="ltr" class="lead-input" />
                    </div>
                    <div class="form-group-viewer">
                        <label for="lead-note" class="lead-label i18n-lead-note">ملاحظة أو رسالة (اختياري)</label>
                        <textarea id="lead-note" rows="2" placeholder="سبب التواصل أو ملاحظة سريعة..." class="lead-input"></textarea>
                    </div>
                    <div class="qr-modal-actions" style="margin-top:8px;">
                        <button type="submit" class="btn-qr-action" id="lead-submit-btn" style="background:#10b981;color:#fff;width:100%;justify-content:center;">
                            <i class="fas fa-paper-plane"></i> <span class="i18n-send-now">إرسال بياناتي الآن</span>
                        </button>
                    </div>
                    <% if (cleanWa) { %>
                    <button type="button" class="btn-qr-action secondary" id="lead-wa-direct-btn" style="width:100%;justify-content:center;margin-top:4px;">
                        <i class="fab fa-whatsapp" style="color:#25D366;"></i> <span class="i18n-send-wa">إرسال ومحادثة عبر واتساب</span>
                    </button>
                    <% } %>
                </form>
            </div>
        </div>

        <!-- QR Modal -->
        <div id="qrModal" class="qr-modal-overlay">
            <div class="qr-modal-box">
                <div class="qr-modal-header">
                    <h4 class="i18n-qr-title">كود المشاركة السريع</h4>
                    <button type="button" class="close-btn" id="ejs-qr-close-btn">&times;</button>
                </div>
                <div class="qr-code-display">
                    <img id="ejs-qr-img" src="<%= images.qrCode || 'https://chart.googleapis.com/chart?cht=qr&chs=250x250&chl=' + encodeURIComponent(canonical || pageUrl) %>" alt="QR Code">
                </div>
                <p class="i18n-qr-desc">امسح الكود بالكاميرا لفتح البطاقة بشكل مباشر</p>
                <div class="qr-modal-actions">
                    <button type="button" class="btn-qr-action" id="ejs-qr-download-btn">
                        <i class="fas fa-download"></i> <span class="i18n-qr-download">تحميل كود QR</span>
                    </button>
                    <button type="button" class="btn-qr-action secondary" id="ejs-qr-copy-link-btn">
                        <i class="fas fa-link"></i> <span class="i18n-qr-copylink">نسخ الرابط</span>
                    </button>
                </div>
            </div>
        </div>

        <div class="seo-links">
            <%- contactLinksHtml %>
        </div>

        <script>
            // UI Interactions Logic
            function openQrModal() {
                const modal = document.getElementById('qrModal');
                if (modal) {
                    modal.classList.add('show');
                    document.body.style.overflow = 'hidden';
                }
            }
            
            function closeQrModal(e) {
                if (e && e.target !== document.getElementById('qrModal') && e.target.closest('.close-btn') === null) return;
                const modal = document.getElementById('qrModal');
                if (modal) {
                    modal.classList.remove('show');
                    document.body.style.overflow = '';
                }
            }
            
            // --- Toast Notification System ---
            function showToast(message, type = 'success', duration = 3000) {
                let container = document.getElementById('ejs-toast-container');
                if (!container) {
                    container = document.createElement('div');
                    container.id = 'ejs-toast-container';
                    document.body.appendChild(container);
                }
                const iconMap = { success: 'fa-check-circle', error: 'fa-times-circle', info: 'fa-info-circle' };
                const toast = document.createElement('div');
                toast.className = 'ejs-toast toast-' + type;
                toast.innerHTML = '<i class="fas ' + (iconMap[type] || iconMap.info) + '"></i><span>' + message + '</span>';
                container.appendChild(toast);
                requestAnimationFrame(() => {
                    requestAnimationFrame(() => { toast.classList.add('show'); });
                });
                setTimeout(() => {
                    toast.classList.remove('show');
                    setTimeout(() => toast.remove(), 400);
                }, duration);
            }

            function copyToClipboard(text) {
                if (navigator.clipboard) {
                    navigator.clipboard.writeText(text).then(() => {
                        showToast('تم النسخ بنجاح ✅', 'success', 2500);
                    }).catch(err => {
                        console.error('Failed to copy text: ', err);
                        showToast('فشل النسخ', 'error');
                    });
                } else {
                    const textArea = document.createElement("textarea");
                    textArea.value = text;
                    document.body.appendChild(textArea);
                    textArea.select();
                    try {
                        document.execCommand('copy');
                        showToast('تم النسخ بنجاح ✅', 'success', 2500);
                    } catch (err) {
                        console.error('Failed to copy text: ', err);
                        showToast('فشل النسخ', 'error');
                    }
                    document.body.removeChild(textArea);
                }
            }

            // VCF Generation Logic (Rich Executive vCard 3.0 / 4.0 with Embedded Photo)
            async function saveContact() {
                const cardName = <%- JSON.stringify(inputs['input-name'] || name || '') %>;
                const cardTitle = <%- JSON.stringify(inputs['input-tagline'] || '') %>;
                const cardCompany = <%- JSON.stringify(inputs['input-company'] || (typeof company !== 'undefined' ? company : '') || '') %>;
                const cardBio = <%- JSON.stringify(typeof cardBio !== 'undefined' ? cardBio : '') %>;
                const photoSrc = <%- JSON.stringify(images.photo || inputs['input-photo'] || inputs['input-logo'] || '') %>;
                const pageUrl = window.location.href;

                let lines = [
                    'BEGIN:VCARD',
                    'VERSION:3.0',
                    'FN;CHARSET=UTF-8:' + cardName.replace(/\n/g, ' '),
                    'N;CHARSET=UTF-8:;' + cardName.replace(/\n/g, ' ') + ';;;'
                ];

                if (cardTitle) {
                    lines.push('TITLE;CHARSET=UTF-8:' + cardTitle.replace(/\n/g, ' '));
                }
                if (cardCompany) {
                    lines.push('ORG;CHARSET=UTF-8:' + cardCompany.replace(/\n/g, ' '));
                }

                // Add embedded photo if available (Base64)
                if (photoSrc) {
                    try {
                        const base64Data = await new Promise((resolve) => {
                            const img = new Image();
                            img.crossOrigin = 'anonymous';
                            img.onload = function() {
                                try {
                                    const canvas = document.createElement('canvas');
                                    const maxDim = 320;
                                    let w = img.naturalWidth || maxDim;
                                    let h = img.naturalHeight || maxDim;
                                    if (w > maxDim || h > maxDim) {
                                        if (w > h) { h = Math.round((h * maxDim) / w); w = maxDim; }
                                        else { w = Math.round((w * maxDim) / h); h = maxDim; }
                                    }
                                    canvas.width = w;
                                    canvas.height = h;
                                    const ctx = canvas.getContext('2d');
                                    ctx.drawImage(img, 0, 0, w, h);
                                    const dataUrl = canvas.toDataURL('image/jpeg', 0.85);
                                    resolve(dataUrl.split(',')[1]);
                                } catch (err) {
                                    resolve(null);
                                }
                            };
                            img.onerror = () => resolve(null);
                            img.src = photoSrc;
                        });
                        if (base64Data) {
                            lines.push('PHOTO;ENCODING=b;TYPE=JPEG:' + base64Data);
                        }
                    } catch (e) {
                        console.warn('Could not embed photo in vCard', e);
                    }
                }

                // Add Phones
                <% if (typeof phones !== 'undefined' && Array.isArray(phones) && phones.length > 0) { %>
                    <% phones.forEach(function(phone, idx) { 
                        const phoneVal = (typeof phone === 'string') ? phone : (phone && phone.value ? phone.value : '');
                    %>
                        if (<%- JSON.stringify(phoneVal) %>) {
                            lines.push('<%= idx === 0 ? "TEL;TYPE=CELL;PREF:" : "TEL;TYPE=CELL:" %>' + <%- JSON.stringify(phoneVal) %>);
                        }
                    <% }); %>
                <% } else if (dynamic.phones) { %>
                    <% dynamic.phones.forEach(function(phone, idx) { %>
                        lines.push('<%= idx === 0 ? "TEL;TYPE=CELL;PREF:" : "TEL;TYPE=CELL:" %>' + <%- JSON.stringify(phone.value) %>);
                    <% }); %>
                <% } %>

                // Add Emails
                <% if (typeof emails !== 'undefined' && Array.isArray(emails) && emails.length > 0) { %>
                    <% emails.forEach(function(em, idx) { 
                        const emVal = (typeof em === 'string') ? em : (em && em.value ? em.value : '');
                    %>
                        if (<%- JSON.stringify(emVal) %>) {
                            lines.push('<%= idx === 0 ? "EMAIL;TYPE=INTERNET;PREF:" : "EMAIL;TYPE=INTERNET:" %>' + <%- JSON.stringify(emVal) %>);
                        }
                    <% }); %>
                <% } else if (dynamic.staticSocial && dynamic.staticSocial.email) { %>
                    lines.push('EMAIL;TYPE=INTERNET;PREF:' + <%- JSON.stringify(dynamic.staticSocial.email.value) %>);
                <% } %>

                // Add Website & Page URL
                <% if (dynamic.staticSocial && dynamic.staticSocial.website) { %>
                    lines.push('URL;TYPE=WORK:' + <%- JSON.stringify(dynamic.staticSocial.website.value) %>);
                <% } %>
                lines.push('URL;TYPE=DigitalCard:' + pageUrl);

                // Add Social Profiles
                <% if (typeof socialLinks !== 'undefined' && Array.isArray(socialLinks)) { %>
                    <% socialLinks.forEach(function(soc) { %>
                        lines.push('X-SOCIALPROFILE;TYPE=<%= soc.platform %>:' + <%- JSON.stringify(soc.url) %>);
                    <% }); %>
                <% } %>

                if (cardBio) {
                    lines.push('NOTE;CHARSET=UTF-8:' + cardBio.replace(/\n/g, '\\n'));
                }

                lines.push('REV:' + new Date().toISOString());
                lines.push('END:VCARD');

                const vcard = lines.join('\r\n');
                const blob = new Blob([vcard], { type: 'text/vcard;charset=utf-8;' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = (cardName.replace(/[\\/:*?"<>|]/g, '_') || 'contact') + '.vcf';
                document.body.appendChild(a);
                a.click();
                setTimeout(() => {
                    document.body.removeChild(a);
                    URL.revokeObjectURL(url);
                }, 400);
            }

            // Haptic feedback helper
            function triggerHaptic(duration = 25) {
                if ('vibrate' in navigator) {
                    try {
                        navigator.vibrate(duration);
                    } catch (e) {}
                }
            }

            // Enhanced save with success animation
            function saveContactEnhanced() {
                saveContact();
                triggerHaptic(40);
                const btn = document.getElementById('ejs-save-btn');
                if (btn) {
                    btn.classList.add('saved');
                    const icon = btn.querySelector('i');
                    const text = btn.querySelector('span');
                    if (icon) icon.className = 'fas fa-check-circle';
                    if (text) text.textContent = 'تم الحفظ ✅';
                    showToast('تم حفظ جهة الاتصال بنجاح ✅', 'success');
                    setTimeout(() => {
                        btn.classList.remove('saved');
                        if (icon) icon.className = 'fas fa-user-plus';
                        if (text) text.textContent = 'حفظ كجهة اتصال';
                    }, 3000);
                }
            }

            // Save button attention pulse
            setTimeout(() => {
                const saveBtn = document.getElementById('ejs-save-btn');
                if (saveBtn) {
                    saveBtn.classList.add('pulse');
                    saveBtn.addEventListener('animationend', () => saveBtn.classList.remove('pulse'));
                }
            }, 4000);

            // Enhanced copy with button feedback
            document.querySelectorAll('.copy-btn').forEach(btn => {
                btn.removeAttribute('onclick');
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    triggerHaptic(20);
                    const text = this.closest('.contact-card')?.querySelector('.contact-text')?.textContent?.trim();
                    if (text) {
                        copyToClipboard(text);
                        this.classList.add('copy-success');
                        const icon = this.querySelector('i');
                        if (icon) {
                            icon.className = 'fas fa-check';
                            setTimeout(() => {
                                icon.className = 'fas fa-copy';
                                this.classList.remove('copy-success');
                            }, 1500);
                        }
                    }
                });
            });

            async function shareCard() {
                triggerHaptic(20);
                if (navigator.share) {
                    try {
                        await navigator.share({
                            title: '<%= name %>',
                            text: 'تفضل بطاقة عملي الرقمية',
                            url: window.location.href
                        });
                    } catch (err) {
                        console.log('Share failed', err);
                    }
                } else {
                    navigator.clipboard.writeText(window.location.href).then(() => {
                        showToast('تم نسخ رابط البطاقة 🔗', 'info', 2500);
                    });
                }
            }

            async function addToStory() {
                const frontImg = document.querySelector('#card-front-display img');
                if (!frontImg || !frontImg.src) {
                    showToast('جاري تجهيز الصورة، يرجى الانتظار...', 'info');
                    return;
                }
                
                try {
                    const res = await fetch(frontImg.src);
                    const blob = await res.blob();
                    const file = new File([blob], 'card_story.png', { type: 'image/png' });
                    
                    if (navigator.canShare && navigator.canShare({ files: [file] })) {
                        await navigator.share({
                            files: [file],
                            title: '<%= inputs["input-name"] %>',
                            text: 'اسحب للأعلى لزيارة بطاقتي!'
                        });
                    } else {
                        const a = document.createElement('a');
                        a.href = frontImg.src;
                        a.download = 'card_for_story.png';
                        a.click();
                        showToast('تم تنزيل الصورة! افتح انستجرام وأضفها للستوري 📸', 'success', 4000);
                    }
                } catch (err) {
                    console.log('Story share failed:', err);
                }
            }

            // ═══════════════════════════════════════════════════════════════
            // STORY GENERATOR (EJS VERSION)
            // ═══════════════════════════════════════════════════════════════
            function openStoryGenerator() {
                let modal = document.getElementById('ejs-story-modal');
                if (!modal) {
                    modal = document.createElement('div');
                    modal.id = 'ejs-story-modal';
                    modal.className = 'qr-modal-overlay';
                    modal.innerHTML = `
                        <div class="qr-modal-box" style="max-width:420px;padding:0;max-height:92vh;display:flex;flex-direction:column;overflow:hidden;">
                            <!-- Header -->
                            <div style="padding:18px 20px 12px;border-bottom:1px solid rgba(255,255,255,0.08);flex-shrink:0;">
                                <div class="qr-modal-header" style="margin-bottom:8px;">
                                    <h4><i class="fab fa-instagram" style="color:#E4405F;margin-left:8px;"></i> مولّد صورة الستوري</h4>
                                    <button class="close-btn" data-story-action="close">&times;</button>
                                </div>
                                <p style="color:#9ca3af;font-size:0.85rem;margin:0;text-align:center;">اختر الثيم وحمّل صورة جاهزة للستوري</p>
                            </div>

                            <!-- Scrollable Content -->
                            <div style="flex:1;overflow-y:auto;padding:16px 20px;-webkit-overflow-scrolling:touch;">
                                <div id="ejs-story-themes" style="display:flex;gap:8px;margin-bottom:14px;justify-content:center;flex-wrap:wrap;">
                                    <button class="story-theme-opt active" data-theme="midnight" style="width:38px;height:38px;border-radius:50%;border:3px solid #4da6ff;cursor:pointer;background:linear-gradient(135deg,#0f0c29,#302b63,#24243e);box-shadow:0 0 0 3px rgba(77,166,255,0.3);transition:all 0.2s;"></button>
                                    <button class="story-theme-opt" data-theme="ocean" style="width:38px;height:38px;border-radius:50%;border:3px solid transparent;cursor:pointer;background:linear-gradient(135deg,#0077b6,#00b4d8,#90e0ef);transition:all 0.2s;"></button>
                                    <button class="story-theme-opt" data-theme="sunset" style="width:38px;height:38px;border-radius:50%;border:3px solid transparent;cursor:pointer;background:linear-gradient(135deg,#f72585,#b5179e,#7209b7);transition:all 0.2s;"></button>
                                    <button class="story-theme-opt" data-theme="forest" style="width:38px;height:38px;border-radius:50%;border:3px solid transparent;cursor:pointer;background:linear-gradient(135deg,#132a13,#31572c,#4f772d);transition:all 0.2s;"></button>
                                    <button class="story-theme-opt" data-theme="gold" style="width:38px;height:38px;border-radius:50%;border:3px solid transparent;cursor:pointer;background:linear-gradient(135deg,#1a1a2e,#c9a227,#f4d03f);transition:all 0.2s;"></button>
                                    <button class="story-theme-opt" data-theme="minimal" style="width:38px;height:38px;border-radius:50%;border:3px solid transparent;cursor:pointer;background:linear-gradient(135deg,#fafafa,#e0e0e0);transition:all 0.2s;"></button>
                                </div>
                                <div style="width:100%;aspect-ratio:9/16;border-radius:14px;overflow:hidden;box-shadow:0 8px 30px rgba(0,0,0,0.3);">
