                <i class="fas fa-phone-alt"></i>
            </div>
            <div class="tile-info">
                <span class="tile-title i18n-tile-contact"><%= (typeof initialLang !== 'undefined' && initialLang === 'en') ? 'Direct Contact' : 'الاتصال والتواصل' %></span>
                <span class="tile-sub"><%= (safeDynamic.phones ? safeDynamic.phones.length : 0) + (cleanWa ? 1 : 0) + (mainEmail ? 1 : 0) %> <%= (typeof initialLang !== 'undefined' && initialLang === 'en') ? 'Channels' : 'قنوات اتصال' %></span>
            </div>
            <i class="fas fa-chevron-left tile-arrow"></i>
        </button>

        <!-- Tile 2: Social Networks Sheet Trigger -->
        <button class="action-tile-btn" id="tile-social-btn" data-sheet-target="sheet-social" aria-label="الشبكات المهنية">
            <div class="tile-icon-box tile-purple">
                <i class="fas fa-globe"></i>
            </div>
            <div class="tile-info">
                <span class="tile-title i18n-tile-social"><%= (typeof initialLang !== 'undefined' && initialLang === 'en') ? 'Social & Networks' : 'الشبكات المهنية' %></span>
                <span class="tile-sub"><%= followMethods.length %> <%= (typeof initialLang !== 'undefined' && initialLang === 'en') ? 'Profiles' : 'منصات وروابط' %></span>
            </div>
            <i class="fas fa-chevron-left tile-arrow"></i>
        </button>

        <!-- Tile 3: Two-Way Lead Capture Modal Trigger -->
        <button class="action-tile-btn" id="tile-exchange-btn" aria-label="تبادل جهات الاتصال">
            <div class="tile-icon-box tile-emerald">
                <i class="fas fa-handshake"></i>
            </div>
            <div class="tile-info">
                <span class="tile-title i18n-tile-exchange"><%= (typeof initialLang !== 'undefined' && initialLang === 'en') ? 'Exchange Info' : 'تبادل جهات الاتصال' %></span>
                <span class="tile-sub i18n-tile-exchange-sub"><%= (typeof initialLang !== 'undefined' && initialLang === 'en') ? 'Send your info to me' : 'أرسل بياناتك للبقاء على تواصل' %></span>
            </div>
            <i class="fas fa-chevron-left tile-arrow"></i>
        </button>

        <!-- Tile 4: QR Code Modal Trigger -->
        <button class="action-tile-btn" id="tile-qr-btn" aria-label="رمز QR الذكي">
            <div class="tile-icon-box tile-gold">
                <i class="fas fa-qrcode"></i>
            </div>
            <div class="tile-info">
                <span class="tile-title i18n-tile-qr"><%= (typeof initialLang !== 'undefined' && initialLang === 'en') ? 'Smart QR Code' : 'رمز QR الذكي' %></span>
                <span class="tile-sub i18n-tile-qr-sub"><%= (typeof initialLang !== 'undefined' && initialLang === 'en') ? 'Scan from phone' : 'امسح الرمز بهاتفك' %></span>
            </div>
            <i class="fas fa-chevron-left tile-arrow"></i>
        </button>

        <!-- Tile 5: Story Generator Studio Trigger -->
        <button class="action-tile-btn" id="tile-story-btn" aria-label="مشاركة في الستوري">
            <div class="tile-icon-box tile-pink">
                <i class="fab fa-instagram"></i>
            </div>
            <div class="tile-info">
                <span class="tile-title i18n-tile-story"><%= (typeof initialLang !== 'undefined' && initialLang === 'en') ? 'Story Creator' : 'مشاركة في الستوري' %></span>
                <span class="tile-sub i18n-tile-story-sub"><%= (typeof initialLang !== 'undefined' && initialLang === 'en') ? '6 Luxury Templates' : '6 قوالب فاخرة للقصص' %></span>
            </div>
            <i class="fas fa-chevron-left tile-arrow"></i>
        </button>

        <!-- Tile 6: Executive Bio / Statement Sheet Trigger (if bio exists) -->
        <% if (cardBio || cardComp || avail) { %>
        <button class="action-tile-btn" id="tile-bio-btn" data-sheet-target="sheet-bio" aria-label="نبذة عني">
            <div class="tile-icon-box tile-amber">
                <i class="fas fa-user-tie"></i>
            </div>
            <div class="tile-info">
                <span class="tile-title i18n-tile-bio"><%= (typeof initialLang !== 'undefined' && initialLang === 'en') ? 'About & Bio' : 'الملف التعريفي' %></span>
                <span class="tile-sub"><%= cardComp || 'نبذة عن صاحب البطاقة' %></span>
            </div>
            <i class="fas fa-chevron-left tile-arrow"></i>
        </button>
