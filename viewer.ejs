<!DOCTYPE html>
<html lang="<%= typeof initialLang !== 'undefined' ? initialLang : 'ar' %>" dir="<%= typeof initialDir !== 'undefined' ? initialDir : 'rtl' %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= name %><%= tagline ? ' | ' + tagline : '' %> - بطاقة عمل رقمية | MC PRIME</title>

    <!-- Meta Tags for SEO & Sharing -->
    <% const pageDesc = (typeof bio !== 'undefined' && bio) ? bio.substring(0, 160) : (name + (tagline ? ' - ' + tagline : '') + ' | بطاقة عمل رقمية ذكية بتقنية NFC ومشاركة جهات الاتصال'); %>
    <meta name="description" content="<%= pageDesc %>">
    <meta name="keywords" content="<%= keywords %>">
    <meta name="robots" content="index, follow, max-image-preview:large">
    <link rel="canonical" href="<%= canonical || pageUrl %>">

    <!-- Open Graph (Facebook / WhatsApp / LinkedIn) -->
    <meta property="og:title" content="<%= name %><%= tagline ? ' | ' + tagline : '' %>">
    <meta property="og:description" content="<%= pageDesc %>">
    <meta property="og:image" content="<%= ogImage %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="<%= name %> - بطاقة عمل رقمية">
    <meta property="og:type" content="profile">
    <meta property="og:url" content="<%= canonical || pageUrl %>">
    <meta property="og:site_name" content="MC PRIME Digital Cards">

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= name %><%= tagline ? ' | ' + tagline : '' %>">
    <meta name="twitter:description" content="<%= pageDesc %>">
    <meta name="twitter:image" content="<%= ogImage %>">

    <!-- Google Search Structured Data (JSON-LD) -->
    <script type="application/ld+json">
    <%- (typeof structuredDataJson !== 'undefined' && structuredDataJson) ? structuredDataJson : JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": name,
      "jobTitle": tagline || 'بطاقة عمل رقمية',
      "image": ogImage,
      "url": canonical || pageUrl
    }) %>
    </script>

    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Cairo:wght@600;700&family=Poppins:wght@400;600&family=Tajawal:wght@400;700&family=Lalezar&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --bg-color: #121212;
            --card-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-color);
            font-family: 'Tajawal', sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            overflow-x: hidden;
            padding: 20px 20px 120px 20px;
            color: #fff;
        }

        /* --- حاوية الكارت (الأساسية) --- */
        .cards-container {
            perspective: 1000px;
            width: 100%;
            display: flex;
            justify-content: center;
            margin-bottom: 30px;
        }

        .cards-wrapper {
            position: relative;
            width: 100%;
            /* الأبعاد الافتراضية (كلاسيك / عرضي) */
            max-width: 510px;
            aspect-ratio: 51 / 33;
            transform-style: preserve-3d;
            transition: transform 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            cursor: pointer;
        }

        /* --- التعديل الخاص بالوضع الطولي (Vertical) --- */
        .cards-wrapper[data-layout="vertical"] {
            max-width: 330px;
            /* عرض أقل للهاتف */
            aspect-ratio: 33 / 51;
            /* عكس النسبة لتصبح طولية */
        }

        .cards-wrapper.is-flipped {
            transform: rotateY(180deg);
        }

        /* --- وجه الكارت (عام) --- */
        .business-card {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border-radius: 15px;
            overflow: hidden;
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
            box-shadow: var(--card-shadow);
            background-color: #000;
            /* Fallback */
        }

        /* iOS Safari requires explicit transform on BOTH faces for backface-visibility to work */
        .card-front {
            transform: rotateY(0deg);
        }

        .card-back {
            transform: rotateY(180deg);
        }

        /* --- الطبقات الداخلية --- */
        .card-background-layer,
        .card-gradient-layer {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            background-size: cover;
            background-position: center;
            z-index: 1;
        }

        .card-gradient-layer {
            z-index: 2;
        }

        .card-content {
            position: relative;
            z-index: 3;
            width: 100%;
            height: 100%;
            padding: 5%;
            display: flex;
            flex-direction: column;
            align-items: center;
            /* هام: لضمان عمل الإحداثيات المطلقة */
            /* لكن العناصر المحفوظة تستخدم translate، لذا لا نحتاج position:relative للعناصر الأبناء بالضرورة */
        }

        /* --- العناصر المتحركة (المحفوظة بالإحداثيات) --- */
        .draggable-element {
            position: absolute;
            top: 0;
            left: 0;
            /* يتم تطبيق translate عبر inline-style */
            touch-action: none;
            /* لمنع التفاعل الخاطئ */
        }

        /* تنسيقات خاصة للعناصر */
        #card-logo {
            object-fit: contain;
        }

        #card-photo {
            background-size: cover;
            background-position: center;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
        }

        #card-name,
        #card-tagline {
            white-space: pre-wrap;
            text-align: center;
            margin: 0;
            line-height: 1.4;
        }

        /* أزرار الهاتف */
        .phone-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            white-space: nowrap;
            transition: transform 0.2s;
        }

        .phone-btn:active {
            transform: scale(0.95);
        }

        .phone-btn i {
            margin-inline-end: 8px;
        }

        /* أيقونات التواصل */
        .social-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            border-radius: 50px;
            transition: transform 0.2s;
        }

        .social-btn:active {
            transform: scale(0.95);
        }

        .social-btn i {
            margin-inline-end: 5px;
        }

        /* QR Code */
        .qr-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            border-radius: 4px;
            background: #fff;
            padding: 2px;
        }

        /* --- أزرار التحكم أسفل الكارت --- */
        .actions-bar {
            display: flex;
            gap: 15px;
            margin-top: 20px;
            flex-wrap: wrap;
            justify-content: center;
            z-index: 100;
        }

        .action-btn {
            background: #243447;
            color: #fff;
            border: 1px solid #364f6b;
            padding: 12px 24px;
            border-radius: 50px;
            text-decoration: none;
            font-family: 'Tajawal', sans-serif;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s;
            cursor: pointer;
        }

        .action-btn:hover {
            background: #4da6ff;
            border-color: #4da6ff;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(77, 166, 255, 0.3);
        }

        .action-btn.primary {
            background: #4da6ff;
            border-color: #4da6ff;
        }

        .action-btn.primary:hover {
            background: #3a8ecc;
        }

        /* تلميح للتقليب */
        .flip-hint {
            margin-top: 15px;
            color: #888;
            font-size: 0.9rem;
            animation: bounce 2s infinite;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        @keyframes bounce {

            0%,
            20%,
            50%,
            80%,
            100% {
                transform: translateY(0);
            }

            40% {
                transform: translateY(-5px);
            }

            60% {
                transform: translateY(-3px);
            }
        }

        /* إخفاء الروابط المباشرة لمحركات البحث في العرض البصري (موجودة في السيرفر للـ SEO) */
        .seo-links {
            display: none;
        }

        /* --- PROFILE & NEW LAYOUT STYLES --- */
        .fade-in-up {
            opacity: 0;
            transform: translateY(20px);
            animation: fadeInUp 0.6s ease forwards;
        }

        @keyframes fadeInUp {
            to { opacity: 1; transform: translateY(0); }
        }

        .profile-structured-section {
            width: 100%;
            max-width: 510px;
            margin: 0 auto;
            text-align: center;
        }

        .profile-bio {
            font-size: 1.05rem;
            line-height: 1.6;
            color: #d1d5db;
            margin: 15px 0;
            padding: 0 15px;
            white-space: pre-wrap;
        }

        .availability-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 14px;
            border-radius: 50px;
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 20px;
            background: rgba(255, 255, 255, 0.1);
        }

        .badge-available { background: rgba(34, 197, 94, 0.15); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.3); }
        .badge-freelance { background: rgba(168, 85, 247, 0.15); color: #c084fc; border: 1px solid rgba(168, 85, 247, 0.3); }
        .badge-busy { background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); }

        .pulse-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: currentColor;
            box-shadow: 0 0 8px currentColor;
            animation: pulse-dot-anim 1.5s infinite;
        }

        @keyframes pulse-dot-anim {
            0% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.5); opacity: 0.5; }
            100% { transform: scale(1); opacity: 1; }
        }

        /* --- QUICK ACTIONS ROW --- */
        .quick-actions-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin: 15px auto 25px auto;
            flex-wrap: wrap;
            max-width: 510px;
        }

        .quick-action-btn {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            text-decoration: none;
            color: #cbd5e1;
            font-size: 0.78rem;
            font-weight: 600;
            background: none;
            border: none;
            cursor: pointer;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            min-width: 56px;
            padding: 4px;
        }

        .quick-action-btn:hover {
            color: #fff;
            transform: translateY(-3px);
        }

        .quick-action-btn:active {
            transform: scale(0.94);
        }

        .quick-action-icon {
            width: 52px;
            height: 52px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.25);
            transition: all 0.25s;
        }

        .quick-action-btn:hover .quick-action-icon {
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4);
            border-color: rgba(197, 160, 89, 0.35);
        }

        /* --- BENTO GRID LAYOUT --- */
        .bento-container {
            display: flex;
            flex-direction: column;
            gap: 16px;
            text-align: right;
            padding: 0 4px;
            margin-bottom: 25px;
        }

        .bento-card {
            background: rgba(18, 26, 43, 0.7);
            border: 1px solid rgba(197, 160, 89, 0.18);
            border-radius: 20px;
            padding: 20px;
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
            transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
        }

        .bento-card:hover {
            border-color: rgba(197, 160, 89, 0.35);
            box-shadow: 0 15px 35px -10px rgba(0, 0, 0, 0.65), 0 0 20px rgba(197, 160, 89, 0.08);
        }

        .bento-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 12px;
        }

        .bento-name {
            font-size: 1.4rem;
            font-weight: 800;
            color: #f8fafc;
            margin: 0 0 4px 0;
            font-family: 'Tajawal', sans-serif;
        }

        .bento-tagline {
            color: #c5a059;
            font-size: 0.95rem;
            font-weight: 600;
            margin: 0 0 6px 0;
        }

        .bento-company {
            display: flex;
            align-items: center;
            gap: 6px;
            color: #94a3b8;
            font-size: 0.85rem;
        }

        .bento-bio-text {
            color: #cbd5e1;
            font-size: 0.95rem;
            line-height: 1.7;
            margin: 0;
            white-space: pre-wrap;
        }

        .bento-section-title {
            font-size: 1.05rem;
            font-weight: 700;
            color: #f1f5f9;
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .contact-info {
            display: flex;
            flex-direction: column;
            gap: 2px;
            text-align: right;
        }

        .contact-type-label {
            font-size: 0.72rem;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .follow-external-icon {
            margin-right: auto;
            font-size: 0.75rem;
            opacity: 0.5;
            transition: transform 0.2s, opacity 0.2s;
        }

        .follow-pill:hover .follow-external-icon {
            transform: translate(-2px, -2px);
            opacity: 1;
        }

        /* --- QR MODAL ENHANCEMENT --- */
        .qr-modal-actions {
            display: flex;
            gap: 10px;
            margin-top: 15px;
            justify-content: center;
        }

        .btn-qr-action {
            background: var(--accent-color, #c5a059);
            color: #0b0f19;
            border: none;
            padding: 10px 18px;
            border-radius: 50px;
            font-weight: 700;
            font-size: 0.85rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s;
        }

        .btn-qr-action:hover {
            transform: translateY(-2px);
            filter: brightness(1.1);
        }

        .btn-qr-action.secondary {
            background: rgba(255, 255, 255, 0.1);
            color: #e2e8f0;
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        .btn-qr-action.secondary:hover {
            background: rgba(255, 255, 255, 0.18);
        }

        .secondary-actions {
            display: flex;
            gap: 10px;
            justify-content: center;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }

        .sec-action-btn {
            background: rgba(255, 255, 255, 0.05);
            color: #e5e7eb;
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 10px 18px;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-family: inherit;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
            backdrop-filter: blur(5px);
        }

        .sec-action-btn:hover {
            background: rgba(255, 255, 255, 0.1);
            transform: translateY(-2px);
        }

        .dynamic-links-container {
            text-align: right;
            padding: 0 5px;
        }

        .group-title {
            font-size: 1.1rem;
            color: #9ca3af;
            font-weight: 600;
            margin-bottom: 15px;
            padding-right: 5px;
            border-right: 3px solid #4da6ff;
        }

        .link-group {
            margin-bottom: 30px;
        }

        .contact-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 15px;
            margin-bottom: 12px;
            transition: transform 0.2s, background 0.2s, box-shadow 0.2s;
            opacity: 0;
            transform: translateY(15px);
            animation: cardSlideIn 0.45s ease forwards;
        }

        .contact-card:nth-child(1) { animation-delay: 0.1s; }
        .contact-card:nth-child(2) { animation-delay: 0.2s; }
        .contact-card:nth-child(3) { animation-delay: 0.3s; }
        .contact-card:nth-child(4) { animation-delay: 0.4s; }
        .contact-card:nth-child(5) { animation-delay: 0.5s; }

        @keyframes cardSlideIn {
            to { opacity: 1; transform: translateY(0); }
        }

        .contact-card:hover {
            background: rgba(255, 255, 255, 0.06);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
            transform: translateX(-4px);
        }

        .contact-card:active {
            transform: scale(0.97);
            transition: transform 0.1s ease;
        }

        .contact-card-main {
            display: flex;
            align-items: center;
            gap: 15px;
            text-decoration: none;
            flex-grow: 1;
        }

        .contact-icon {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .contact-text {
            color: #fff;
            font-size: 1.1rem;
            font-weight: 600;
            direction: ltr;
            text-align: right;
            word-break: break-all;
        }

        .copy-btn {
            background: transparent;
            border: none;
            color: #9ca3af;
            width: 44px;
            height: 44px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: background 0.2s, color 0.2s;
            flex-shrink: 0;
        }

        .copy-btn:hover { background: rgba(255, 255, 255, 0.1); color: #fff; }

        .copy-btn.copy-success {
            color: #2ecc71 !important;
            animation: copyPop 0.4s ease;
        }

        @keyframes copyPop {
            0% { transform: scale(1); }
            50% { transform: scale(1.3); }
            100% { transform: scale(1); }
        }

        .follow-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
            gap: 12px;
        }

        .follow-pill {
            text-decoration: none;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            padding: 12px 15px;
            display: flex;
            align-items: center;
            gap: 10px;
            color: #fff;
            transition: all 0.2s;
        }

        .follow-pill:hover {
            border-color: var(--brand, rgba(255, 255, 255, 0.3));
            background: rgba(255, 255, 255, 0.08);
            transform: translateY(-2px);
        }

        .follow-pill i { color: var(--brand, #fff); font-size: 1.2rem; }

        /* Sticky footer and Save button styles are now in viewer.css */

        /* Story Generator button */
        .story-gen-btn {
            background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);
            background-size: 200% 200%;
            animation: gradientShift 3s ease infinite;
        }

        @keyframes gradientShift {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .qr-modal-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.8); backdrop-filter: blur(5px);
            z-index: 2000; display: flex; align-items: center; justify-content: center;
            opacity: 0; pointer-events: none; transition: opacity 0.3s;
        }
        .qr-modal-overlay.show { opacity: 1; pointer-events: auto; }
        .qr-modal-box {
            background: #1f2937; padding: 25px; border-radius: 20px; width: 90%; max-width: 350px; text-align: center;
            transform: translateY(20px); transition: transform 0.3s;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5); border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .qr-modal-overlay.show .qr-modal-box { transform: translateY(0); }
        .qr-modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
        .qr-modal-header h4 { margin: 0; font-size: 1.2rem; }
        .close-btn { background: transparent; border: none; color: #9ca3af; font-size: 1.5rem; cursor: pointer; }
        .qr-code-display { background: #fff; padding: 15px; border-radius: 12px; margin-bottom: 15px; display: inline-block; }
        .qr-code-display img { width: 200px; height: 200px; border-radius: 5px; }
        .qr-modal-box p { color: #9ca3af; font-size: 0.95rem; margin: 0; }

        /* --- Toast Notification System --- */
        #ejs-toast-container {
            position: fixed;
            bottom: 100px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 9999;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            pointer-events: none;
        }

        .ejs-toast {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 24px;
            border-radius: 50px;
            font-size: 0.9rem;
            font-weight: 600;
            color: #fff;
            background: rgba(30, 45, 64, 0.95);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(77, 166, 255, 0.3);
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
            opacity: 0;
            transform: translateY(20px) scale(0.95);
            transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
            pointer-events: none;
            white-space: nowrap;
            max-width: 90vw;
        }

        .ejs-toast.show {
            opacity: 1;
            transform: translateY(0) scale(1);
        }

        .ejs-toast.toast-success { border-color: rgba(46, 204, 113, 0.4); }
        .ejs-toast.toast-success i { color: #2ecc71; }
        .ejs-toast.toast-error { border-color: rgba(231, 76, 60, 0.4); }
        .ejs-toast.toast-error i { color: #e74c3c; }
        .ejs-toast.toast-info { border-color: rgba(77, 166, 255, 0.4); }
        .ejs-toast.toast-info i { color: #4da6ff; }

        /* --- VIEWER TOP BAR & CONTROLS --- */
        .viewer-top-bar {
            width: 100%;
            max-width: 510px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 22px;
            padding: 0 4px;
            z-index: 20;
        }

        .brand-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #cbd5e1;
            text-decoration: none;
            font-size: 0.88rem;
            font-weight: 700;
            letter-spacing: 0.5px;
            transition: all 0.25s;
            background: rgba(255, 255, 255, 0.05);
            padding: 5px 12px;
            border-radius: 50px;
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .brand-badge:hover {
            color: #fff;
            border-color: rgba(197, 160, 89, 0.4);
            background: rgba(197, 160, 89, 0.12);
        }

        .brand-logo {
            height: 20px;
            width: auto;
            object-fit: contain;
        }

        .top-bar-controls {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .ctrl-pill-btn {
            background: rgba(255, 255, 255, 0.06);
            color: #cbd5e1;
            border: 1px solid rgba(255, 255, 255, 0.12);
            padding: 6px 14px;
            border-radius: 50px;
            font-size: 0.8rem;
            font-family: inherit;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }

        .ctrl-pill-btn:hover {
            background: rgba(197, 160, 89, 0.2);
            border-color: rgba(197, 160, 89, 0.4);
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        }

        .ctrl-pill-btn:active {
            transform: scale(0.95);
        }

        /* --- EXCHANGE LEAD CAPTURE MODAL & STICKY ACTIONS --- */
        .exchange-modal-box {
            max-width: 440px;
        }

        .form-group-viewer {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .lead-label {
            font-size: 0.82rem;
            font-weight: 600;
            color: #94a3b8;
        }

        .lead-input {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.14);
            border-radius: 12px;
            padding: 10px 14px;
            color: #fff;
            font-family: inherit;
            font-size: 0.92rem;
            transition: border-color 0.2s, box-shadow 0.2s;
            outline: none;
            width: 100%;
        }

        .lead-input:focus {
            border-color: #10b981;
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
        }

        .sticky-footer-actions {
            display: flex;
            gap: 10px;
            width: 100%;
            max-width: 440px;
        }

        .sticky-footer-actions .save-contact-btn {
            flex: 1.2;
            width: auto;
        }

        .exchange-contact-btn {
            flex: 0.9;
            background: rgba(16, 185, 129, 0.18);
            border: 1px solid rgba(16, 185, 129, 0.4);
            color: #34d399;
            padding: 14px 16px;
            border-radius: 50px;
            font-family: inherit;
            font-weight: 700;
            font-size: 0.9rem;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            backdrop-filter: blur(12px);
        }

        .exchange-contact-btn:hover {
            background: #10b981;
            color: #0b0f19;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(16, 185, 129, 0.35);
        }

        .exchange-contact-btn:active {
            transform: scale(0.96);
        }
    </style>
    <link rel="stylesheet" href="/nfc/premium-ui.css">
</head>

<body>

    <!-- Top Bar Controls -->
    <header class="viewer-top-bar fade-in-up" aria-label="رأس صفحة الكارت">
        <a href="/nfc/" class="brand-badge" title="MC PRIME NFC">
            <img src="/nfc/mc-prime-nfc.png" alt="MC PRIME" class="brand-logo" onerror="this.style.display='none'">
            <span>MC PRIME</span>
        </a>
        <div class="top-bar-controls">
            <button type="button" class="ctrl-pill-btn" id="view-mode-toggle" aria-label="تبديل وضع العرض">
                <i class="fas fa-cube"></i>
                <span id="view-mode-label"><%= (typeof initialLang !== 'undefined' && initialLang === 'en') ? 'Hide Card' : 'إخفاء الكارت' %></span>
            </button>
            <button type="button" class="ctrl-pill-btn lang-toggle-btn" id="ejs-lang-toggle" aria-label="Switch language">
                <i class="fas fa-globe"></i>
                <span id="lang-btn-text"><%= (typeof initialLang !== 'undefined' && initialLang === 'en') ? 'عربي' : 'EN' %></span>
            </button>
        </div>
    </header>

    <!-- استخراج البيانات من كائن design -->
    <% const inputs=design.inputs || {}; const dynamic=design.dynamic || {}; const images=design.imageUrls || {}; const
        positions=design.positions || {}; const placements=design.placements || {}; const
        layout=inputs['layout-select-visual'] || inputs['layout-select'] || 'classic' ; function getStyle(id) { const
        pos=positions[id] || {x:0, y:0}; return `transform: translate(${pos.x}px, ${pos.y}px);`; } function
        isFront(elementName) { const place=placements[elementName]; if (!place) { if (elementName==='logo' ) return
        true; if (elementName==='photo' ) return true; if (elementName==='name' ) return true; if
        (elementName==='tagline' ) return true; if (elementName==='qr' ) return false; return true; } return
        place==='front' ; } function getFilterStyle(prefix) { const filters=[]; if
        (inputs[`${prefix}-filter-grayscale`]) filters.push(`grayscale(${inputs[`${prefix}-filter-grayscale`]}%)`); if
        (inputs[`${prefix}-filter-sepia`]) filters.push(`sepia(${inputs[`${prefix}-filter-sepia`]}%)`); if
        (inputs[`${prefix}-filter-blur`]) filters.push(`blur(${inputs[`${prefix}-filter-blur`]}px)`); if
        (inputs[`${prefix}-filter-invert`]) filters.push(`invert(${inputs[`${prefix}-filter-invert`]}%)`); if
        (inputs[`${prefix}-filter-brightness`]) filters.push(`brightness(${inputs[`${prefix}-filter-brightness`]}%)`);
        if (inputs[`${prefix}-filter-contrast`]) filters.push(`contrast(${inputs[`${prefix}-filter-contrast`]}%)`);
        return filters.length> 0 ? `filter: ${filters.join(' ')};` : '';
        }

        function getTextStyle(prefix) {
        let style = '';
        if (inputs[`${prefix}-letter-spacing`]) style += `letter-spacing: ${inputs[`${prefix}-letter-spacing`]}px; `;
        if (inputs[`${prefix}-line-height`]) style += `line-height: ${inputs[`${prefix}-line-height`]}; `;
        if (inputs[`${prefix}-uppercase`]) style += `text-transform: uppercase; `;
        if (inputs[`${prefix}-glow`]) {
        const color = inputs[`${prefix}-color`] || '#fff';
        style += `text-shadow: 0 0 10px ${color}, 0 0 20px ${color}; `;
        }
        return style;
        }

        function getBtnStyle(prefix) {
        const styleType = inputs[`${prefix}-style`] || 'solid';
        const radius = inputs[`${prefix}-radius`] !== undefined ? inputs[`${prefix}-radius`] : 50;
        const bg = inputs[`${prefix}-bg-color`] || inputs[`back-buttons-bg-color`] || '#364f6b';
        const text = inputs[`${prefix}-text-color`] || inputs[`back-buttons-text-color`] || '#aab8c2';

        let style = `border-radius: ${radius}px; `;
        if (styleType === 'outline') {
        style += `background-color: transparent !important; color: ${bg} !important; border: 2px solid ${bg} !important;
        `;
        } else if (styleType === 'glass') {
        style += `background: rgba(255, 255, 255, 0.2) !important; backdrop-filter: blur(10px); -webkit-backdrop-filter:
        blur(10px); border: 1px solid rgba(255, 255, 255, 0.3) !important; color: ${text} !important; box-shadow: 0 4px
        6px rgba(0, 0, 0, 0.1) !important; `;
        } else {
        style += `background-color: ${bg} !important; color: ${text} !important; border: 2px solid transparent
        !important; `;
        }
        return style;
        }

        function getDynamicPositionStyle(item) {
        const pos = item && item.position ? item.position : {};
        const rawX = Number(pos.x);
        const rawY = Number(pos.y);
        const x = Number.isFinite(rawX) ? rawX : 0;
        const y = Number.isFinite(rawY) ? rawY : 0;
        return `transform: translate(${x}px, ${y}px);`;
        }
        %>

        <div class="cards-container">
            <!-- تطبيق data-layout لتفعيل CSS الوضع الطولي -->
            <div class="cards-wrapper" id="card"
                data-layout="<%= layout %>">

                <!-- === الوجه الأمامي === -->
                <div class="business-card card-front">
                    <!-- الخلفية -->
                    <div class="card-background-layer"
                        style="background-image: url('<%= images.front || '' %>'); display: <%= images.front ? 'block' : 'none' %>;">
                    </div>
                    <div class="card-gradient-layer"
                        style="background: linear-gradient(135deg, <%= inputs['front-bg-start'] || '#2a3d54' %>, <%= inputs['front-bg-end'] || '#223246' %>); opacity: <%= images.front ? (inputs['front-bg-opacity'] || 0.3) : 1 %>;">
                    </div>

                    <div class="card-content">
                        <!-- العناصر الأساسية (إذا كانت في الأمام) -->
                        <% if (isFront('logo')) { %>
                            <img id="card-logo" src="<%= inputs['input-logo'] %>" class="draggable-element"
                                style="<%= getStyle('card-logo') %>; max-width: <%= inputs['logo-size'] %>%; opacity: <%= inputs['logo-opacity'] %>; <%= getFilterStyle('logo') %>">
                            <% } %>

                                <% if (isFront('photo') && images.photo) { %>
                                    <div id="card-photo" class="draggable-element"
                                        style="<%= getStyle('card-personal-photo-wrapper') %>; width: <%= inputs['photo-size'] %>%; aspect-ratio: 1/1; border-radius: <%= inputs['photo-shape'] === 'circle' ? '50%' : '8px' %>; border: <%= inputs['photo-border-width'] %>px solid <%= inputs['photo-border-color'] %>; background-image: url('<%= images.photo %>'); <%= getFilterStyle('photo') %> <%= inputs['photo-glass-effect'] ? 'mix-blend-mode: screen; opacity: 0.9;' : '' %>">
                                    </div>
                                    <% } %>

                                        <% if (isFront('name')) { %>
                                            <h1 id="card-name" class="draggable-element"
                                                style="<%= getStyle('card-name') %>; color: <%= inputs['name-color'] %>; font-size: <%= inputs['name-font-size'] %>px; font-family: <%= inputs['name-font'] %>; <%= getTextStyle('name') %>">
                                                <%= inputs['input-name'] %>
                                            </h1>
                                            <% } %>

                                                <% if (isFront('tagline')) { %>
                                                    <h2 id="card-tagline" class="draggable-element"
                                                        style="<%= getStyle('card-tagline') %>; color: <%= inputs['tagline-color'] %>; font-size: <%= inputs['tagline-font-size'] %>px; font-family: <%= inputs['tagline-font'] %>; <%= getTextStyle('tagline') %>">
                                                        <%= inputs['input-tagline'] %>
                                                    </h2>
                                                    <% } %>

                                                        <% if (isFront('qr') && inputs['qr-source'] !=='none' ) { %>
                                                            <div class="draggable-element qr-wrapper"
                                                                style="<%= getStyle('qr-code-wrapper') %>; width: <%= inputs['qr-size'] %>%;">
                                                                <img
                                                                    src="<%= images.qrCode || 'https://chart.googleapis.com/chart?cht=qr&chs=200x200&chl=' + encodeURIComponent(pageUrl) %>">
                                                            </div>
                                                            <% } %>

                                                                <!-- الهواتف (ديناميكي) -->
                                                                <% if (dynamic.phones) { dynamic.phones.forEach(phone=>
                                                                    {
                                                                    if (phone.placement === 'front' && phone.value) { %>
                                                                    <div class="draggable-element"
                                                                        style="<%= getDynamicPositionStyle(phone) %>">
                                                                        <a href="tel:<%= phone.value %>"
                                                                            class="phone-btn" style="
                                <%= getBtnStyle('phone-btn') %>
                                font-size: <%= inputs['phone-btn-font-size'] %>px;
                                font-family: <%= inputs['phone-btn-font'] %>;
                                padding: <%= inputs['phone-btn-padding'] %>px <%= inputs['phone-btn-padding']*2 %>px;
                                <% if(inputs['toggle-phone-buttons'] === false) { %> background: transparent !important; box-shadow: none !important; border: none !important; padding: 2px !important; <% } %>
                            ">
                                                                            <i class="fas fa-phone-alt"></i>
                                                                            <span>
                                                                                <%= phone.value %>
                                                                            </span>
                                                                        </a>
                                                                    </div>
                                                                    <% }}); } %>
                    </div>
                </div>

                <!-- === الوجه الخلفي === -->
                <div class="business-card card-back">
                    <!-- الخلفية -->
                    <div class="card-background-layer"
                        style="background-image: url('<%= images.back || '' %>'); display: <%= images.back ? 'block' : 'none' %>;">
                    </div>
                    <div class="card-gradient-layer"
                        style="background: linear-gradient(135deg, <%= inputs['back-bg-start'] || '#2a3d54' %>, <%= inputs['back-bg-end'] || '#223246' %>); opacity: <%= images.back ? (inputs['back-bg-opacity'] || 0.3) : 1 %>;">
                    </div>

                    <div class="card-content">
                        <!-- العناصر الأساسية (إذا كانت في الخلف) -->
                        <% if (!isFront('logo')) { %>
                            <img id="card-logo" src="<%= inputs['input-logo'] %>" class="draggable-element"
                                style="<%= getStyle('card-logo') %>; max-width: <%= inputs['logo-size'] %>%; opacity: <%= inputs['logo-opacity'] %>; <%= getFilterStyle('logo') %>">
                            <% } %>

                                <% if (!isFront('photo') && images.photo) { %>
                                    <div id="card-photo" class="draggable-element"
                                        style="<%= getStyle('card-personal-photo-wrapper') %>; width: <%= inputs['photo-size'] %>%; aspect-ratio: 1/1; border-radius: <%= inputs['photo-shape'] === 'circle' ? '50%' : '8px' %>; border: <%= inputs['photo-border-width'] %>px solid <%= inputs['photo-border-color'] %>; background-image: url('<%= images.photo %>'); <%= getFilterStyle('photo') %> <%= inputs['photo-glass-effect'] ? 'mix-blend-mode: screen; opacity: 0.9;' : '' %>">
                                    </div>
                                    <% } %>

                                        <% if (!isFront('name')) { %>
                                            <h1 id="card-name" class="draggable-element"
                                                style="<%= getStyle('card-name') %>; color: <%= inputs['name-color'] %>; font-size: <%= inputs['name-font-size'] %>px; font-family: <%= inputs['name-font'] %>; <%= getTextStyle('name') %>">
                                                <%= inputs['input-name'] %>
                                            </h1>
                                            <% } %>

                                                <% if (!isFront('tagline')) { %>
                                                    <h2 id="card-tagline" class="draggable-element"
                                                        style="<%= getStyle('card-tagline') %>; color: <%= inputs['tagline-color'] %>; font-size: <%= inputs['tagline-font-size'] %>px; font-family: <%= inputs['tagline-font'] %>; <%= getTextStyle('tagline') %>">
                                                        <%= inputs['input-tagline'] %>
                                                    </h2>
                                                    <% } %>

                                                        <% if (!isFront('qr') && inputs['qr-source'] !=='none' ) { %>
                                                            <div class="draggable-element qr-wrapper"
                                                                style="<%= getStyle('qr-code-wrapper') %>; width: <%= inputs['qr-size'] %>%;">
                                                                <img
                                                                    src="<%= images.qrCode || 'https://chart.googleapis.com/chart?cht=qr&chs=200x200&chl=' + encodeURIComponent(pageUrl) %>">
                                                            </div>
                                                            <% } %>

                                                                <!-- الهواتف (إذا كانت في الخلف) -->
                                                                <% if (dynamic.phones) { dynamic.phones.forEach(phone=>
                                                                    {
                                                                    if (phone.placement === 'back' && phone.value) { %>
                                                                    <div class="draggable-element"
                                                                        style="<%= getDynamicPositionStyle(phone) %>">
                                                                        <a href="tel:<%= phone.value %>"
                                                                            class="phone-btn" style="
                                <%= getBtnStyle('phone-btn') %>
                                font-size: <%= inputs['phone-btn-font-size'] %>px;
                                font-family: <%= inputs['phone-btn-font'] %>;
                                padding: <%= inputs['phone-btn-padding'] %>px <%= inputs['phone-btn-padding']*2 %>px;
                                <% if(inputs['toggle-phone-buttons'] === false) { %> background: transparent !important; box-shadow: none !important; border: none !important; padding: 2px !important; <% } %>
                            ">
                                                                            <i class="fas fa-phone-alt"></i>
                                                                            <span>
                                                                                <%= phone.value %>
                                                                            </span>
                                                                        </a>
                                                                    </div>
                                                                    <% }}); } %>

                                                                        <!-- روابط التواصل الاجتماعي (Static & Dynamic) -->
                                                                        <%
                                                                            const platforms = {
                                                                                whatsapp: { icon: 'fab fa-whatsapp', prefix: 'https://wa.me/' },
                                                                                email: { icon: 'fas fa-envelope', prefix: 'mailto:' },
                                                                                website: { icon: 'fas fa-globe', prefix: '' },
                                                                                facebook: { icon: 'fab fa-facebook-f', prefix: '' },
                                                                                linkedin: { icon: 'fab fa-linkedin-in', prefix: '' },
                                                                                instagram: { icon: 'fab fa-instagram', prefix: '' },
                                                                                x: { icon: 'fab fa-xing', prefix: '' },
                                                                                telegram: { icon: 'fab fa-telegram', prefix: '' },
                                                                                tiktok: { icon: 'fab fa-tiktok', prefix: '' },
                                                                                snapchat: { icon: 'fab fa-snapchat', prefix: '' },
                                                                                youtube: { icon: 'fab fa-youtube', prefix: '' },
                                                                                pinterest: { icon: 'fab fa-pinterest', prefix: '' }
                                                                            };
                                                                            const allSocials = [];
                                                                            if (dynamic.staticSocial) {
                                                                                Object.entries(dynamic.staticSocial).forEach(([key, data]) => {
                                                                                    if (data && data.value) {
                                                                                        allSocials.push({ ...data, type: key, isStatic: true });
                                                                                    }
                                                                                });
                                                                            }
                                                                            if (dynamic.social) {
                                                                                dynamic.social.forEach(item => {
                                                                                    if (item && item.value) {
                                                                                        allSocials.push({ ...item, type: item.platform, isStatic: false });
                                                                                    }
                                                                                });
                                                                            }
                                                                        %>

                                                                            <% allSocials.forEach(item=> {
                                                                                const platform = platforms[item.type] || { icon: 'fas fa-link', prefix: '' };
                                                                                const btnBg = inputs['back-buttons-bg-color'];
                                                                                const btnColor = inputs['back-buttons-text-color'];
                                                                                const customColor = item.color || inputs[`input-static-${item.type}-color`] || btnColor;
                                                                                const customSize = item.size || inputs[`input-static-${item.type}-size`] || inputs['social-text-size'];

                                                                                let url = item.value;
                                                                                if (item.type === 'email' && !url.startsWith('mailto:')) url = 'mailto:' + url;
                                                                                else if (item.type === 'whatsapp') url = 'https://wa.me/' + url.replace(/\D/g,'');
                                                                                else if (!url.startsWith('http')) url = 'https://' + url;

                                                                                const itemPlacement = item.placement || 'back';
                                                                                if (itemPlacement === 'back') {
                                                                                %>
                                                                                <div class="draggable-element"
                                                                                    style="<%= getDynamicPositionStyle(item) %>">
                                                                                    <a href="<%= url %>" target="_blank"
                                                                                        class="social-btn" style="
                                <%= getBtnStyle('back-buttons') %>
                                color: <%= inputs['toggle-social-buttons'] !== false ? inputs['back-buttons-text-color'] : (customColor !== btnColor ? customColor : inputs['social-text-color']) %> !important;
                                font-size: <%= inputs['back-buttons-size'] %>px;
                                padding: <%= inputs['back-buttons-size']*0.5 %>px <%= inputs['back-buttons-size'] %>px;
                                font-family: <%= inputs['back-buttons-font'] %>;
                                <% if(inputs['toggle-social-buttons'] === false) { %> background: transparent !important; box-shadow: none !important; border: none !important; padding: 2px !important; <% } %>
                            ">
                                                                                        <i class="<%= platform.icon %>"
                                                                                            style="font-size: <%= inputs['toggle-social-buttons'] !== false ? '' : (customSize+'px') %>;"></i>
                                                                                        <span
                                                                                            style="font-size: <%= inputs['toggle-social-buttons'] !== false ? '' : (customSize+'px') %>; font-family: <%= inputs['toggle-social-buttons'] !== false ? '' : inputs['social-text-font'] %>">
                                                                                            <%= item.value %>
                                                                                        </span>
                                                                                    </a>
                                                                                </div>
                                                                                <% } }); %>

                    </div>
                </div>
            </div>

            <div class="flip-hint">
                <i class="fas fa-hand-pointer"></i> اضغط على البطاقة لقلبها
            </div>

            </div>

        <!-- === EXECUTIVE BENTO GRID SECTION (MOBILE & DESKTOP OPTIMIZED) === -->
        <main class="profile-structured-section fade-in-up" id="main-content" style="animation-delay: 0.2s;">
            
            <!-- Quick Actions Icon Row -->
            <div class="quick-actions-row">
                <% 
                   const mainPhone = (dynamic.phones && dynamic.phones[0]) ? String(dynamic.phones[0].value).replace(/\D/g,'') : '';
                   const mainEmail = (dynamic.staticSocial && dynamic.staticSocial.email) ? dynamic.staticSocial.email.value : ((allSocials.find(s => s.type === 'email')) ? allSocials.find(s => s.type === 'email').value : '');
                   const mainWhatsapp = (dynamic.staticSocial && dynamic.staticSocial.whatsapp) ? dynamic.staticSocial.whatsapp.value : ((allSocials.find(s => s.type === 'whatsapp')) ? allSocials.find(s => s.type === 'whatsapp').value : '');
                   const cleanWa = mainWhatsapp ? String(mainWhatsapp).replace(/\D/g, '') : mainPhone;
                   const waGreeting = encodeURIComponent('مرحباً ' + name + '، تشرفت بالاطلاع على بطاقة عملك الرقمية.');
                %>
                <% if (mainPhone) { %>
                <a href="tel:<%= mainPhone %>" class="quick-action-btn" aria-label="اتصال هاتفي" title="اتصال">
                    <div class="quick-action-icon" style="background: rgba(59, 130, 246, 0.15); color: #3b82f6;">
                        <i class="fas fa-phone-alt"></i>
                    </div>
                    <span>اتصال</span>
                </a>
                <% } %>
                
                <% if (cleanWa) { %>
                <a href="https://wa.me/<%= cleanWa %>?text=<%= waGreeting %>" target="_blank" rel="noopener noreferrer" class="quick-action-btn" aria-label="محادثة واتساب" title="واتساب">
                    <div class="quick-action-icon" style="background: rgba(37, 211, 102, 0.15); color: #25D366;">
                        <i class="fab fa-whatsapp"></i>
                    </div>
                    <span>واتساب</span>
                </a>
                <% } %>

                <% if (mainEmail) { %>
                <a href="mailto:<%= mainEmail %>" class="quick-action-btn" aria-label="إرسال بريد" title="بريد">
                    <div class="quick-action-icon" style="background: rgba(239, 68, 68, 0.15); color: #ef4444;">
                        <i class="fas fa-envelope"></i>
                    </div>
                    <span>بريد</span>
                </a>
                <% } %>

                <button type="button" class="quick-action-btn" id="ejs-exchange-open-btn" aria-label="تبادل جهات الاتصال" title="تبادل البيانات">
                    <div class="quick-action-icon" style="background: rgba(16, 185, 129, 0.15); color: #10b981;">
                        <i class="fas fa-handshake"></i>
                    </div>
                    <span class="i18n-exchange">تبادل البيانات</span>
                </button>

                <button type="button" class="quick-action-btn" id="ejs-share-btn" aria-label="مشاركة البطاقة" title="مشاركة">
                    <div class="quick-action-icon" style="background: rgba(197, 160, 89, 0.15); color: #c5a059;">
                        <i class="fas fa-share-nodes"></i>
                    </div>
                    <span class="i18n-share">مشاركة</span>
                </button>

                <button type="button" class="quick-action-btn" id="ejs-qr-open-btn" aria-label="عرض رمز QR" title="رمز QR">
                    <div class="quick-action-icon" style="background: rgba(168, 85, 247, 0.15); color: #a855f7;">
                        <i class="fas fa-qrcode"></i>
                    </div>
                    <span>رمز QR</span>
                </button>

                <button type="button" class="quick-action-btn story-gen-btn" id="ejs-story-open-btn" aria-label="إنشاء ستوري" title="ستوري">
                    <div class="quick-action-icon" style="background: linear-gradient(135deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888); color: #fff;">
                        <i class="fab fa-instagram"></i>
                    </div>
                    <span>ستوري</span>
                </button>
            </div>

            <!-- Bento Container -->
            <div class="bento-container">
                <!-- Bento Item 1: Executive Profile Statement -->
                <% 
                   const cardBio = (typeof bio !== 'undefined' && bio) ? bio : (inputs['input-bio_ar'] || inputs['input-bio_en'] || inputs['input-bio']);
                   const cardComp = (typeof company !== 'undefined' && company) ? company : (inputs['input-company_ar'] || inputs['input-company_en'] || inputs['input-company']);
                   const avail = inputs['input-availability'];
                %>
                <% if (cardBio || cardComp || avail) { %>
                <article class="bento-card bento-bio-card">
                    <div class="bento-header">
                        <div class="bento-title-group">
                            <h2 class="bento-name"><%= name %></h2>
                            <% if (tagline) { %>
                            <p class="bento-tagline"><%= tagline %></p>
                            <% } %>
                            <% if (cardComp) { %>
                            <div class="bento-company">
                                <i class="fas fa-building"></i> <span><%= cardComp %></span>
                            </div>
                            <% } %>
                        </div>
                        <% if (avail) { 
                            let badgeClass = 'badge-freelance'; let text = 'متاح لمشاريع مستقلة';
                            if (avail === 'available') { badgeClass = 'badge-available'; text = 'متاح للعمل'; }
                            if (avail === 'busy') { badgeClass = 'badge-busy'; text = 'مشغول حالياً'; }
                        %>
                        <div class="availability-badge <%= badgeClass %>">
                            <span class="pulse-dot"></span> <%= text %>
                        </div>
                        <% } %>
                    </div>
                    <% if (cardBio) { %>
                    <p class="bento-bio-text"><%= cardBio %></p>
                    <% } %>
                </article>
                <% } %>

                <!-- Bento Item 2: Direct Contact Methods -->
                <% 
                const contactMethods = allSocials.filter(s => ['whatsapp', 'email'].includes(s.type));
                if (dynamic.phones) {
                    dynamic.phones.forEach(p => {
                        if (p && p.value) contactMethods.unshift({ type: 'phone', value: p.value });
                    });
                }
                const followMethods = allSocials.filter(s => !['whatsapp', 'email', 'phone'].includes(s.type));
                %>

                <% if (contactMethods.length > 0) { %>
                <section class="bento-card bento-contact-card" aria-labelledby="contact-heading">
                    <h3 class="bento-section-title" id="contact-heading">
                        <i class="fas fa-address-book" style="color: #c5a059;"></i> وسائل الاتصال المباشرة
                    </h3>
                    <div class="contact-list">
                        <% contactMethods.forEach(item => { 
                            let url = item.value;
                            let display = item.value;
                            let icon = 'fas fa-phone-alt'; let color = '#3b82f6'; let copyLabel = 'نسخ الرقم';
                            if (item.type === 'email') {
                                if (!url.startsWith('mailto:')) url = 'mailto:' + url;
                                icon = 'fas fa-envelope'; color = '#ef4444'; copyLabel = 'نسخ البريد';
                            } else if (item.type === 'whatsapp') {
                                const cleanNum = String(url).replace(/\D/g,'');
                                url = 'https://wa.me/' + cleanNum + '?text=' + waGreeting;
                                icon = 'fab fa-whatsapp'; color = '#25D366'; copyLabel = 'نسخ الرقم';
                            } else {
                                url = 'tel:' + String(url).replace(/\D/g,'');
                            }
                        %>
                        <div class="contact-card">
                            <a href="<%= url %>" class="contact-card-main" <%= item.type === 'whatsapp' ? 'target="_blank" rel="noopener noreferrer"' : '' %>>
                                <div class="contact-icon" style="background: <%= color %>22; color: <%= color %>;">
                                    <i class="<%= icon %>"></i>
                                </div>
                                <div class="contact-info">
                                    <span class="contact-type-label"><%= item.type === 'email' ? 'البريد الإلكتروني' : (item.type === 'whatsapp' ? 'واتساب مباشر' : 'الهاتف') %></span>
                                    <span class="contact-text" dir="ltr"><%= display %></span>
                                </div>
                            </a>
                            <button type="button" class="copy-btn" aria-label="<%= copyLabel %>" title="<%= copyLabel %>" data-copy-text="<%= display %>">
                                <i class="fas fa-copy"></i>
                            </button>
                        </div>
                        <% }); %>
                    </div>
                </section>
                <% } %>

                <!-- Bento Item 3: Social & Digital Presence -->
                <% if (followMethods.length > 0) { %>
                <section class="bento-card bento-social-card" aria-labelledby="social-heading">
                    <h3 class="bento-section-title" id="social-heading">
                        <i class="fas fa-globe" style="color: #c5a059;"></i> الحسابات والشبكات المهنية
                    </h3>
                    <div class="follow-grid">
                        <% followMethods.forEach(item => { 
                            let url = item.value;
                            if (!url.startsWith('http')) url = 'https://' + url;
                            const platform = platforms[item.type] || { icon: 'fas fa-link' };
                            let color = '#aab8c2';
                            const brandColors = {
                                facebook: '#1877F2', linkedin: '#0A66C2', instagram: '#E4405F',
                                x: '#ffffff', twitter: '#ffffff', tiktok: '#ff0050', youtube: '#FF0000', snapchat: '#FFFC00', telegram: '#229ED9', github: '#ffffff'
                            };
                            if (brandColors[item.type]) color = brandColors[item.type];
                        %>
                            <a href="<%= url %>" target="_blank" rel="noopener noreferrer" class="follow-pill" style="--brand: <%= color %>;">
                                <i class="<%= platform.icon %>"></i>
                                <span><%= item.type.charAt(0).toUpperCase() + item.type.slice(1) %></span>
                                <i class="fas fa-arrow-up-right-from-square follow-external-icon"></i>
                            </a>
                        <% }); %>
                    </div>
                </section>
                <% } %>
            </div>
            
            <div style="height: 110px;"></div> <!-- Spacing for floating action bar -->
        </main>

        <!-- LUXURY FLOATING ACTION BAR -->
        <nav class="sticky-footer fade-in-up" style="animation-delay: 0.35s;" aria-label="شريط الإجراءات الرئيسي">
            <div class="sticky-footer-actions">
                <button type="button" class="save-contact-btn" id="ejs-save-btn">
                    <i class="fas fa-user-plus"></i> <span class="i18n-save-btn" style="font-weight:700"><%= (typeof initialLang !== 'undefined' && initialLang === 'en') ? 'Save Contact' : 'حفظ كجهة اتصال' %></span>
                </button>
                <button type="button" class="exchange-contact-btn" id="ejs-footer-exchange-btn" aria-label="تبادل جهات الاتصال">
                    <i class="fas fa-handshake"></i> <span class="i18n-exchange-short"><%= (typeof initialLang !== 'undefined' && initialLang === 'en') ? 'Exchange' : 'تبادل البيانات' %></span>
                </button>
            </div>
            <div class="footer-powered">
                <i class="fas fa-shield-alt" style="color: var(--accent-color, #c5a059);"></i> MC PRIME Digital NFC
            </div>
        </nav>

        <!-- Exchange Contact Modal (Two-Way Lead Capture) -->
        <div id="exchangeModal" class="qr-modal-overlay">
            <div class="qr-modal-box exchange-modal-box">
                <div class="qr-modal-header">
                    <h4 id="exchange-modal-title"><i class="fas fa-handshake" style="color:#10b981;margin-inline-end:8px;"></i> <span class="i18n-exchange-title">تبادل جهات الاتصال</span></h4>
                    <button type="button" class="close-btn" id="ejs-exchange-close-btn">&times;</button>
                </div>
                <p id="exchange-modal-desc" style="color:#94a3b8;font-size:0.88rem;margin:0 0 16px 0;text-align:center;">
                    أرسل بياناتك مباشرة للبقاء على تواصل مستمر
                </p>
                <form id="exchange-lead-form" style="display:flex;flex-direction:column;gap:12px;text-align:start;">
                    <div class="form-group-viewer">
                        <label for="lead-name" class="lead-label i18n-lead-name">الاسم الكامل *</label>
                        <input type="text" id="lead-name" required placeholder="اسمك الكريم" class="lead-input" />
                    </div>
                    <div class="form-group-viewer">
                        <label for="lead-phone" class="lead-label i18n-lead-phone">رقم الهاتف / واتساب *</label>
