                                </div>
                            </div>

                            <!-- Sticky Action Buttons (ALWAYS VISIBLE) -->
                            <div style="padding:14px 20px 18px;border-top:1px solid rgba(255,255,255,0.08);flex-shrink:0;background:#1f2937;">
                                <button data-story-action="share" style="width:100%;background:linear-gradient(45deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888);color:#fff;border:none;padding:16px;border-radius:50px;font-size:1.15rem;cursor:pointer;font-weight:800;font-family:inherit;margin-bottom:10px;box-shadow:0 4px 20px rgba(220,39,67,0.35);display:flex;align-items:center;justify-content:center;gap:10px;">
                                    <i class="fas fa-paper-plane" style="font-size:1.1rem;"></i>
                                    <span>📤 شارك الآن</span>
                                </button>
                                <div style="display:flex;gap:8px;">
                                    <button data-story-action="download" style="flex:1;background:rgba(255,255,255,0.08);color:#fff;border:1px solid rgba(255,255,255,0.15);padding:12px;border-radius:50px;font-size:0.9rem;cursor:pointer;font-weight:600;font-family:inherit;display:flex;align-items:center;justify-content:center;gap:6px;">
                                        <i class="fas fa-download"></i> تحميل الصورة
                                    </button>
                                    <button data-story-action="close" style="flex:1;background:rgba(255,255,255,0.05);color:#9ca3af;border:1px solid rgba(255,255,255,0.1);padding:12px;border-radius:50px;font-size:0.9rem;cursor:pointer;font-weight:600;font-family:inherit;display:flex;align-items:center;justify-content:center;gap:6px;">
