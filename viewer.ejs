                        </div>`;
                    document.body.appendChild(modal);

                    // Theme buttons
                    modal.querySelectorAll('.story-theme-opt').forEach(btn => {
                        btn.addEventListener('click', () => {
                            modal.querySelectorAll('.story-theme-opt').forEach(b => {
                                b.style.borderColor = 'transparent';
                                b.style.boxShadow = 'none';
                            });
                            btn.style.borderColor = '#4da6ff';
                            btn.style.boxShadow = '0 0 0 3px rgba(77,166,255,0.3)';
                            storyTheme = btn.dataset.theme;
                            renderEjsStory();
                        });
                    });

                    modal.querySelector('[data-story-action="share"]').addEventListener('click', shareStory);
                    modal.querySelector('[data-story-action="download"]').addEventListener('click', downloadStory);
                    modal.querySelectorAll('[data-story-action="close"]').forEach(btn => {
                        btn.addEventListener('click', closeStoryModal);
                    });

                    modal.addEventListener('click', e => { if (e.target === modal) closeStoryModal(); });
                }

                modal.classList.add('show');
                document.body.style.overflow = 'hidden';
                renderEjsStory();
            }

            function closeStoryModal() {
                const modal = document.getElementById('ejs-story-modal');
                if (modal) {
                    modal.classList.remove('show');
                    document.body.style.overflow = '';
                }
            }

            let storyTheme = 'midnight';
            const storyThemes = {
                midnight: { bg: ['#0f0c29', '#302b63', '#24243e'], text: '#ffffff', sub: '#a0a0c0', accent: '#4da6ff' },
                ocean:    { bg: ['#0077b6', '#00b4d8', '#90e0ef'], text: '#ffffff', sub: '#d4f1f9', accent: '#00b4d8' },
                sunset:   { bg: ['#f72585', '#b5179e', '#7209b7'], text: '#ffffff', sub: '#f0c0e0', accent: '#f72585' },
                forest:   { bg: ['#132a13', '#31572c', '#4f772d'], text: '#ffffff', sub: '#b0d0a0', accent: '#90be6d' },
                gold:     { bg: ['#1a1a2e', '#16213e', '#0f3460'], text: '#f4d03f', sub: '#c9a227', accent: '#f4d03f' },
                minimal:  { bg: ['#fafafa', '#f0f0f0', '#ffffff'], text: '#1a1a2e', sub: '#666666', accent: '#4da6ff' }
            };

            async function renderEjsStory() {
                const canvas = document.getElementById('ejs-story-canvas');
                if (!canvas) return;
                const ctx = canvas.getContext('2d');
                canvas.width = 1080;
                canvas.height = 1920;
                const theme = storyThemes[storyTheme];

                // Background
                const grad = ctx.createLinearGradient(0, 0, canvas.width, canvas.height);
                grad.addColorStop(0, theme.bg[0]);
                grad.addColorStop(0.5, theme.bg[1]);
                grad.addColorStop(1, theme.bg[2]);
                ctx.fillStyle = grad;
                ctx.fillRect(0, 0, canvas.width, canvas.height);

                // Decorative circles
                ctx.fillStyle = theme.accent;
                ctx.globalAlpha = 0.1;
                ctx.beginPath(); ctx.arc(120, 180, 160, 0, Math.PI * 2); ctx.fill();
                ctx.beginPath(); ctx.arc(960, 1750, 200, 0, Math.PI * 2); ctx.fill();
                ctx.globalAlpha = 1;

                // Dot pattern
                ctx.globalAlpha = 0.03;
                for (let i = 0; i < canvas.width; i += 50) {
                    for (let j = 0; j < canvas.height; j += 50) {
                        ctx.fillStyle = theme.text;
                        ctx.beginPath(); ctx.arc(i, j, 1.5, 0, Math.PI * 2); ctx.fill();
                    }
                }
                ctx.globalAlpha = 1;

                // Tag
                ctx.textAlign = 'center';
                ctx.fillStyle = theme.accent;
                ctx.font = '600 26px "Poppins", sans-serif';
                ctx.fillText('✦  DIGITAL BUSINESS CARD  ✦', canvas.width / 2, 300);

                // Helper: draw card with rotation
                function drawCardEjs(img, x, y, w, h, rotation) {
                    ctx.save();
                    ctx.translate(x + w / 2, y + h / 2);
                    ctx.rotate(rotation * Math.PI / 180);
                    ctx.shadowColor = 'rgba(0,0,0,0.45)'; ctx.shadowBlur = 40; ctx.shadowOffsetY = 15;
                    roundR(ctx, -w/2, -h/2, w, h, 18); ctx.fillStyle = '#000'; ctx.fill();
                    ctx.shadowColor = 'transparent';
                    roundR(ctx, -w/2, -h/2, w, h, 18); ctx.clip();
                    ctx.drawImage(img, -w/2, -h/2, w, h);
                    ctx.strokeStyle = theme.accent; ctx.globalAlpha = 0.35; ctx.lineWidth = 2;
                    roundR(ctx, -w/2, -h/2, w, h, 18); ctx.stroke(); ctx.globalAlpha = 1;
                    ctx.restore();
                }

                // Dynamically load html2canvas
                if (!window.html2canvas) {
                    await new Promise(r => {
                        const s = document.createElement('script');
                        s.src = 'https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js';
                        s.onload = r;
                        document.head.appendChild(s);
                    });
                }

                // Both card faces
                const frontEl = document.querySelector('.card-front');
                const backEl = document.querySelector('.card-back');
                const wrapper = document.querySelector('.cards-wrapper');

                let frontCanvasRaw = null;
                let backCanvasRaw = null;

                if (frontEl || backEl) {
                    // Temporarily flatten 3D transforms for clean capturing
                    const oldWrapperTransform = wrapper ? wrapper.style.transform : '';
                    if (wrapper) wrapper.style.transform = 'none';
                    
                    const oldBackTransform = backEl ? backEl.style.transform : '';
                    if (backEl) backEl.style.transform = 'none';

                    if (backEl) backCanvasRaw = await html2canvas(backEl, { useCORS: true, backgroundColor: '#000000', scale: 2 });
                    if (frontEl) frontCanvasRaw = await html2canvas(frontEl, { useCORS: true, backgroundColor: '#000000', scale: 2 });

                    // Restore transforms
                    if (wrapper) wrapper.style.transform = oldWrapperTransform;
                    if (backEl) backEl.style.transform = oldBackTransform;
                }

                const cardW = 680;
                const cardH = cardW / (51 / 33);

                // Back card (behind, rotated right)
                if (backCanvasRaw) {
                    drawCardEjs(backCanvasRaw, 240, 380, cardW, cardH, 4);
                    ctx.save(); ctx.textAlign = 'center'; ctx.fillStyle = theme.sub; ctx.globalAlpha = 0.6;
                    ctx.font = '500 22px "Tajawal", sans-serif';
                    ctx.fillText('الوجه الخلفي', 580, 380 + cardH + 55);
                    ctx.globalAlpha = 1; ctx.restore();
                }

                // Front card (on top, rotated left)
                if (frontCanvasRaw) {
                    drawCardEjs(frontCanvasRaw, 100, 430, cardW, cardH, -3);
                    ctx.save(); ctx.textAlign = 'center'; ctx.fillStyle = theme.sub; ctx.globalAlpha = 0.6;
                    ctx.font = '500 22px "Tajawal", sans-serif';
                    ctx.fillText('الوجه الأمامي', 440, 430 + cardH + 55);
                    ctx.globalAlpha = 1; ctx.restore();
                }

                // Name
                const nameY = 1100;
                ctx.fillStyle = theme.text;
                ctx.font = '800 60px "Cairo", "Tajawal", sans-serif';
                ctx.fillText('<%= inputs["input-name"] || "" %>', canvas.width / 2, nameY);

                // Tagline
                ctx.fillStyle = theme.sub;
                ctx.font = '500 34px "Tajawal", "Poppins", sans-serif';
                ctx.fillText('<%= inputs["input-tagline"] || "" %>', canvas.width / 2, nameY + 55);

                // Divider
                ctx.strokeStyle = theme.accent; ctx.globalAlpha = 0.25; ctx.lineWidth = 1;
                ctx.beginPath(); ctx.moveTo(360, nameY + 95); ctx.lineTo(720, nameY + 95); ctx.stroke();
                ctx.globalAlpha = 1;

                // QR Code
                try {
                    const qrImg = await loadImg(`https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${encodeURIComponent(window.location.href)}&format=png&qzone=1`);
                    const qrX = (canvas.width - 180) / 2, qrY = nameY + 130;
                    ctx.save(); ctx.fillStyle = '#ffffff';
                    roundR(ctx, qrX - 14, qrY - 14, 208, 208, 14); ctx.fill();
                    ctx.drawImage(qrImg, qrX, qrY, 180, 180); ctx.restore();

                    ctx.fillStyle = theme.sub;
                    ctx.font = '500 24px "Tajawal", sans-serif';
                    ctx.fillText('📱 امسح الكود للتواصل', canvas.width / 2, qrY + 230);
                } catch(e) {}

                // CTA
                const ctaY = 1640;
                ctx.save();
                const ctaGrad = ctx.createLinearGradient(240, ctaY, 840, ctaY + 60);
                ctaGrad.addColorStop(0, theme.accent);
                ctaGrad.addColorStop(1, theme.accent);
                ctx.fillStyle = ctaGrad; ctx.globalAlpha = 0.15;
                roundR(ctx, 280, ctaY, 520, 60, 30); ctx.fill(); ctx.globalAlpha = 1;
                ctx.fillStyle = theme.accent;
                ctx.font = '700 26px "Tajawal", sans-serif';
                ctx.fillText('⬆ اسحب للأعلى لزيارة بطاقتي', canvas.width / 2, ctaY + 40);
                ctx.restore();

                // Branding
                ctx.fillStyle = theme.sub; ctx.globalAlpha = 0.4;
                ctx.font = '500 22px "Poppins", sans-serif';
                ctx.fillText('Powered by MC PRIME', canvas.width / 2, 1810);
                ctx.globalAlpha = 1;
            }

            function roundR(ctx, x, y, w, h, r) {
                ctx.beginPath();
                ctx.moveTo(x + r, y); ctx.lineTo(x + w - r, y);
                ctx.quadraticCurveTo(x + w, y, x + w, y + r);
                ctx.lineTo(x + w, y + h - r);
                ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
                ctx.lineTo(x + r, y + h);
                ctx.quadraticCurveTo(x, y + h, x, y + h - r);
                ctx.lineTo(x, y + r);
                ctx.quadraticCurveTo(x, y, x + r, y);
                ctx.closePath();
            }

            function loadImg(src) {
                return new Promise((resolve, reject) => {
                    const img = new Image();
                    img.crossOrigin = 'anonymous';
                    img.onload = () => resolve(img);
                    img.onerror = reject;
                    img.src = src;
                });
            }

            function downloadStory() {
                const canvas = document.getElementById('ejs-story-canvas');
                if (!canvas) return;
                try {
                    const link = document.createElement('a');
                    link.download = 'story_card.png';
                    link.href = canvas.toDataURL('image/png', 1.0);
                    link.click();
                    showToast('تم تحميل صورة الستوري 📸', 'success');
                } catch (e) {
                    console.error('Download error:', e);
                    showToast('فشل التحميل. تأكد من اتصالك بالإنترنت.', 'error');
                }
            }

            async function shareStory() {
                const canvas = document.getElementById('ejs-story-canvas');
                if (!canvas) return;
                try {
                    const blob = await new Promise(r => canvas.toBlob(r, 'image/png'));
                    const file = new File([blob], 'story_card.png', { type: 'image/png' });
                    if (navigator.canShare && navigator.canShare({ files: [file] })) {
                        await navigator.share({ files: [file], title: '<%= inputs["input-name"] || "بطاقة رقمية" %>', text: 'اسحب للأعلى لزيارة بطاقتي!' });
                    } else {
                        downloadStory();
                    }
                } catch (e) {
                    if (e.name !== 'AbortError') showToast('فشلت المشاركة', 'error');
                }
            }

            // --- Card Flip & Touch Swipe Gestures ---
            const cardEl = document.getElementById('card');
            if (cardEl) {
                cardEl.addEventListener('click', function(e) {
                    // Prevent flip if clicked on actionable sub-element
                    if (e.target.closest('a, button, input')) return;
                    this.classList.toggle('is-flipped');
                    triggerHaptic(30);
                });

                // Mobile Horizontal Swipe gesture (Flip card)
                let touchStartX = 0;
                let touchStartY = 0;
                cardEl.addEventListener('touchstart', function(e) {
                    touchStartX = e.changedTouches[0].screenX;
                    touchStartY = e.changedTouches[0].screenY;
                }, { passive: true });

                cardEl.addEventListener('touchend', function(e) {
                    const touchEndX = e.changedTouches[0].screenX;
                    const touchEndY = e.changedTouches[0].screenY;
                    const deltaX = touchEndX - touchStartX;
                    const deltaY = touchEndY - touchStartY;

                    // Trigger flip on meaningful horizontal swipe
                    if (Math.abs(deltaX) > 45 && Math.abs(deltaX) > Math.abs(deltaY) * 1.5) {
                        cardEl.classList.toggle('is-flipped');
                        triggerHaptic(35);
                    }
                }, { passive: true });
            }

            // --- Exchange Contact Modal (Two-Way Lead Capture) ---
            function openExchangeModal() {
                const modal = document.getElementById('exchangeModal');
                if (modal) {
                    modal.classList.add('show');
                    document.body.style.overflow = 'hidden';
                    setTimeout(() => document.getElementById('lead-name')?.focus(), 150);
                }
            }

            function closeExchangeModal(e) {
                if (e && e.target !== document.getElementById('exchangeModal') && e.target.closest('.close-btn') === null) return;
                const modal = document.getElementById('exchangeModal');
                if (modal) {
                    modal.classList.remove('show');
                    document.body.style.overflow = '';
                }
            }

            // Lead Form Submission
            document.getElementById('exchange-lead-form')?.addEventListener('submit', async function(e) {
                e.preventDefault();
                triggerHaptic(25);
                const submitBtn = document.getElementById('lead-submit-btn');
                const originalContent = submitBtn ? submitBtn.innerHTML : '';
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> <span>جاري الإرسال...</span>';
                }

                const nameVal = document.getElementById('lead-name')?.value?.trim() || '';
                const phoneVal = document.getElementById('lead-phone')?.value?.trim() || '';
                const emailVal = document.getElementById('lead-email')?.value?.trim() || '';
                const noteVal = document.getElementById('lead-note')?.value?.trim() || '';
                const cardId = <%- JSON.stringify(typeof cardShortId !== 'undefined' ? cardShortId : '') %>;

                try {
                    const response = await fetch(`/nfc/api/leads/${encodeURIComponent(cardId)}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ name: nameVal, phone: phoneVal, email: emailVal, note: noteVal })
                    });
                    if (response.ok) {
                        showToast('تم إرسال بياناتك بنجاح ✅', 'success', 3500);
                        closeExchangeModal();
                        document.getElementById('exchange-lead-form')?.reset();
                    } else {
                        throw new Error('Submission returned status ' + response.status);
                    }
                } catch (err) {
                    console.warn('Lead endpoint failed, offering WhatsApp/local fallback:', err);
                    // Fallback to WhatsApp if owner phone exists
                    const waNum = <%- JSON.stringify(cleanWa || '') %>;
                    if (waNum) {
                        const msg = encodeURIComponent(`مرحباً، أنا ${nameVal}\nرقمي: ${phoneVal}${emailVal ? '\nإيميلي: ' + emailVal : ''}${noteVal ? '\nملاحظة: ' + noteVal : ''}`);
                        window.open(`https://wa.me/${waNum}?text=${msg}`, '_blank');
                    }
                    showToast('تم استلام بياناتك بنجاح ✅', 'success', 3000);
                    closeExchangeModal();
                    document.getElementById('exchange-lead-form')?.reset();
                } finally {
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = originalContent;
                    }
                }
            });

            // WhatsApp Direct Lead button
            document.getElementById('lead-wa-direct-btn')?.addEventListener('click', function() {
                triggerHaptic(20);
                const nameVal = document.getElementById('lead-name')?.value?.trim() || 'صديق جديد';
                const phoneVal = document.getElementById('lead-phone')?.value?.trim() || '';
                const emailVal = document.getElementById('lead-email')?.value?.trim() || '';
                const noteVal = document.getElementById('lead-note')?.value?.trim() || '';
                const waNum = <%- JSON.stringify(cleanWa || '') %>;
                if (waNum) {
                    const msg = encodeURIComponent(`مرحباً، تفضل بياناتي للتواصل:\nالاسم: ${nameVal}\nالهاتف: ${phoneVal}${emailVal ? '\nالبريد: ' + emailVal : ''}${noteVal ? '\n' + noteVal : ''}`);
                    window.open(`https://wa.me/${waNum}?text=${msg}`, '_blank');
                    closeExchangeModal();
                }
            });

            // --- Multi-Language Switcher (AR / EN) ---
            const i18nDictionary = {
                ar: {
                    langBtn: 'EN',
                    viewModeHide: 'إخفاء الكارت',
                    viewModeShow: 'عرض الكارت',
                    saveBtn: 'حفظ كجهة اتصال',
                    exchangeShort: 'تبادل البيانات',
                    exchange: 'تبادل البيانات',
                    share: 'مشاركة',
                    exchangeTitle: 'تبادل جهات الاتصال',
                    leadName: 'الاسم الكامل *',
                    leadPhone: 'رقم الهاتف / واتساب *',
                    leadEmail: 'البريد الإلكتروني (اختياري)',
                    leadNote: 'ملاحظة أو رسالة (اختياري)',
                    sendNow: 'إرسال بياناتي الآن',
                    sendWa: 'إرسال ومحادثة عبر واتساب'
                },
                en: {
                    langBtn: 'عربي',
                    viewModeHide: 'Hide Card',
                    viewModeShow: 'Show 3D Card',
                    saveBtn: 'Save Contact',
                    exchangeShort: 'Exchange',
                    exchange: 'Connect',
                    share: 'Share',
                    exchangeTitle: 'Exchange Contact Info',
                    leadName: 'Full Name *',
                    leadPhone: 'Phone / WhatsApp *',
                    leadEmail: 'Email Address (Optional)',
                    leadNote: 'Note or Message (Optional)',
                    sendNow: 'Send My Contact Info',
                    sendWa: 'Send & Chat via WhatsApp'
                }
            };

            let currentLang = document.documentElement.lang || 'ar';
            function toggleLanguage() {
                triggerHaptic(20);
                currentLang = currentLang === 'ar' ? 'en' : 'ar';
                document.documentElement.lang = currentLang;
                document.documentElement.dir = currentLang === 'ar' ? 'rtl' : 'ltr';

                const dict = i18nDictionary[currentLang];
                const langBtn = document.getElementById('lang-btn-text');
                if (langBtn) langBtn.textContent = dict.langBtn;

                const viewModeLabel = document.getElementById('view-mode-label');
                const isCardHidden = document.querySelector('.cards-container')?.style.display === 'none';
                if (viewModeLabel) viewModeLabel.textContent = isCardHidden ? dict.viewModeShow : dict.viewModeHide;

                document.querySelectorAll('.i18n-save-btn').forEach(el => el.textContent = dict.saveBtn);
                document.querySelectorAll('.i18n-exchange-short').forEach(el => el.textContent = dict.exchangeShort);
                document.querySelectorAll('.i18n-exchange').forEach(el => el.textContent = dict.exchange);
                document.querySelectorAll('.i18n-share').forEach(el => el.textContent = dict.share);
                document.querySelectorAll('.i18n-exchange-title').forEach(el => el.textContent = dict.exchangeTitle);
                document.querySelectorAll('.i18n-lead-name').forEach(el => el.textContent = dict.leadName);
                document.querySelectorAll('.i18n-lead-phone').forEach(el => el.textContent = dict.leadPhone);
                document.querySelectorAll('.i18n-lead-email').forEach(el => el.textContent = dict.leadEmail);
                document.querySelectorAll('.i18n-lead-note').forEach(el => el.textContent = dict.leadNote);
                document.querySelectorAll('.i18n-send-now').forEach(el => el.textContent = dict.sendNow);
                document.querySelectorAll('.i18n-send-wa').forEach(el => el.textContent = dict.sendWa);

                showToast(currentLang === 'ar' ? 'تم تحويل الواجهة إلى العربية' : 'Switched to English interface', 'info', 2000);
            }

            // --- View Mode Toggle (3D Card vs Profile Stream) ---
            function toggleViewMode() {
                triggerHaptic(25);
                const cardContainer = document.querySelector('.cards-container');
                const flipHint = document.querySelector('.flip-hint');
                const label = document.getElementById('view-mode-label');
                const dict = i18nDictionary[currentLang] || i18nDictionary.ar;
                if (cardContainer) {
                    if (cardContainer.style.display === 'none') {
                        cardContainer.style.display = 'flex';
                        if (flipHint) flipHint.style.display = 'flex';
                        if (label) label.textContent = dict.viewModeHide;
                        cardContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    } else {
                        cardContainer.style.display = 'none';
                        if (flipHint) flipHint.style.display = 'none';
                        if (label) label.textContent = dict.viewModeShow;
                    }
                }
            }

            // Quick Actions & Modal Triggers
            document.getElementById('ejs-story-open-btn')?.addEventListener('click', openStoryGenerator);
            document.getElementById('ejs-share-btn')?.addEventListener('click', shareCard);
            document.getElementById('ejs-qr-open-btn')?.addEventListener('click', openQrModal);
            document.getElementById('ejs-save-btn')?.addEventListener('click', saveContactEnhanced);
            document.getElementById('ejs-qr-close-btn')?.addEventListener('click', () => closeQrModal());
            document.getElementById('qrModal')?.addEventListener('click', closeQrModal);

            // Exchange Contact Triggers
            document.getElementById('ejs-exchange-open-btn')?.addEventListener('click', openExchangeModal);
            document.getElementById('ejs-footer-exchange-btn')?.addEventListener('click', openExchangeModal);
            document.getElementById('ejs-exchange-close-btn')?.addEventListener('click', closeExchangeModal);
            document.getElementById('exchangeModal')?.addEventListener('click', closeExchangeModal);

            // Header Controls Triggers
            document.getElementById('ejs-lang-toggle')?.addEventListener('click', toggleLanguage);
            document.getElementById('view-mode-toggle')?.addEventListener('click', toggleViewMode);

            // QR Download Button Handler (Converts QR image to PNG download)
            document.getElementById('ejs-qr-download-btn')?.addEventListener('click', function() {
                triggerHaptic(20);
                const qrImg = document.getElementById('ejs-qr-img');
                if (!qrImg) return;
                
                // Draw to canvas to ensure CORS / clean PNG download
                const canvas = document.createElement('canvas');
                canvas.width = 500;
                canvas.height = 500;
                const ctx = canvas.getContext('2d');
                
                const img = new Image();
                img.crossOrigin = 'anonymous';
                img.onload = function() {
                    ctx.fillStyle = '#ffffff';
                    ctx.fillRect(0, 0, 500, 500);
                    ctx.drawImage(img, 25, 25, 450, 450);
                    const link = document.createElement('a');
                    link.download = 'business_card_qr.png';
                    link.href = canvas.toDataURL('image/png');
                    link.click();
                    showToast('تم تحميل رمز الـ QR بنجاح 📥', 'success');
                };
                img.onerror = function() {
                    // Fallback direct download
                    const link = document.createElement('a');
                    link.download = 'business_card_qr.png';
                    link.href = qrImg.src;
                    link.target = '_blank';
                    link.click();
                };
                img.src = qrImg.src;
            });

            // QR Copy Link Handler
            document.getElementById('ejs-qr-copy-link-btn')?.addEventListener('click', function() {
                triggerHaptic(20);
                copyToClipboard(window.location.href);
            });
        </script>
    <script src="/nfc/premium-ui.js" defer></script>
</body>

</html>
