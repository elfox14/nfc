                </button>
                <button class="footer-secondary-btn" id="ejs-qr-copy-link-btn" style="flex: 1;">
                    <i class="fas fa-link"></i>
                    <span><%= (typeof initialLang !== 'undefined' && initialLang === 'en') ? 'Copy Link' : 'نسخ الرابط' %></span>
                </button>
            </div>
