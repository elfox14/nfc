                <% if (tagline) { %><p style="color: #c5a059; font-size: 0.9rem; font-weight: 600; margin-bottom: 12px;"><%= tagline %></p><% } %>
                <% if (cardBio) { %><p style="color: #cbd5e1; font-size: 0.88rem; line-height: 1.6; white-space: pre-line;"><%= cardBio %></p><% } %>
