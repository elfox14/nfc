<!DOCTYPE html>
<html lang="<%= typeof initialLang !== 'undefined' ? initialLang : 'ar' %>" dir="<%= typeof initialDir !== 'undefined' ? initialDir : 'rtl' %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= name %><%= tagline ? ' | ' + tagline : '' %> - بطاقة عمل رقمية | MC PRIME</title>

    <!-- Meta Tags for SEO & Sharing -->
    <% const pageDesc = (typeof bio !== 'undefined' && bio) ? bio.substring(0, 160) : (name + (tagline ? ' - ' + tagline : '') + ' | بطاقة عمل رقمية ذكية بتقنية NFC ومشاركة جهات الاتصال'); %>
    <meta name="description" content="<%= pageDesc %>">
    <meta name="keywords" content="<%= keywords %>">
    <meta name="robots" content="index, follow, max-image-preview:large">
    <link rel="canonical" href="<%= canonical || pageUrl %>">

    <!-- Open Graph (Facebook / WhatsApp / LinkedIn) -->
    <meta property="og:title" content="<%= name %><%= tagline ? ' | ' + tagline : '' %>">
    <meta property="og:description" content="<%= pageDesc %>">
    <meta property="og:image" content="<%= ogImage %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="<%= name %> - بطاقة عمل رقمية">
    <meta property="og:type" content="profile">
    <meta property="og:url" content="<%= canonical || pageUrl %>">
    <meta property="og:site_name" content="MC PRIME Digital Cards">

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= name %><%= tagline ? ' | ' + tagline : '' %>">
    <meta name="twitter:description" content="<%= pageDesc %>">
    <meta name="twitter:image" content="<%= ogImage %>">

    <!-- Google Search Structured Data (JSON-LD) -->
    <script type="application/ld+json">
    <%- (typeof structuredDataJson !== 'undefined' && structuredDataJson) ? structuredDataJson : JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfilePage",
      "mainEntity": {
        "@type": "Person",
        "name": name,
        "jobTitle": tagline || 'بطاقة عمل رقمية',
        "image": ogImage,
        "url": canonical || pageUrl
      }
    }) %>
    </script>

    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Cairo:wght@600;700;800&family=Poppins:wght@400;500;600;700&family=Tajawal:wght@400;500;700;800&family=Lalezar&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <style>
        :root {
            --bg-base: #060913;
            --bg-surface: rgba(13, 19, 33, 0.78);
            --card-shadow: 0 30px 70px -15px rgba(0, 0, 0, 0.95), 0 0 35px -5px rgba(197, 160, 89, 0.25);
            --gold-primary: #c5a059;
            --gold-bright: #e6ca85;
            --gold-gradient: linear-gradient(135deg, #d4af37 0%, #c5a059 50%, #b89047 100%);
            --glass-border: rgba(255, 255, 255, 0.09);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-base);
            background-image: 
                radial-gradient(circle at 50% -10%, rgba(197, 160, 89, 0.18) 0%, transparent 60%),
                radial-gradient(circle at 10% 30%, rgba(56, 189, 248, 0.09) 0%, transparent 50%),
                radial-gradient(circle at 90% 70%, rgba(168, 85, 247, 0.09) 0%, transparent 50%),
                radial-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px);
            background-size: 100% 100%, 100% 100%, 100% 100%, 28px 28px;
            background-attachment: fixed;
            font-family: 'Tajawal', sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            overflow-x: hidden;
            padding: 16px 16px 140px 16px;
            color: #f8fafc;
            position: relative;
        }

        /* Ambient Aurora Orbs */
        .ambient-aurora-container {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 0;
            overflow: hidden;
        }

        .aurora-orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            opacity: 0.35;
            animation: auroraFloat 18s ease-in-out infinite alternate;
        }

        .aurora-gold {
            width: 420px;
            height: 420px;
            background: radial-gradient(circle, rgba(197, 160, 89, 0.45) 0%, transparent 70%);
            top: -100px;
            left: 50%;
            transform: translateX(-50%);
        }

        .aurora-blue {
            width: 380px;
            height: 380px;
            background: radial-gradient(circle, rgba(56, 189, 248, 0.3) 0%, transparent 70%);
            bottom: 15%;
            right: -100px;
            animation-duration: 22s;
        }

        @keyframes auroraFloat {
            0% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(-30px, 40px) scale(1.08); }
            100% { transform: translate(30px, -20px) scale(0.95); }
        }

        /* Top Bar */
        .viewer-top-bar {
            width: 100%;
            max-width: 580px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 14px;
            margin-bottom: 18px;
            background: rgba(13, 19, 33, 0.65);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 50px;
            z-index: 100;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        }

        .top-bar-brand {
            display: flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            color: #f8fafc;
            font-weight: 700;
            font-size: 0.88rem;
        }

        .top-bar-brand img {
            height: 24px;
            width: auto;
        }

        .top-bar-actions {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .top-icon-btn {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.08);
            color: #cbd5e1;
            padding: 6px 14px;
            border-radius: 50px;
            font-size: 0.82rem;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s ease;
            font-family: inherit;
        }

        .top-icon-btn:hover {
            background: rgba(197, 160, 89, 0.2);
            border-color: rgba(197, 160, 89, 0.4);
            color: #ffffff;
            transform: translateY(-1px);
        }

        /* Executive Persona Header */
        .executive-hero-header {
            width: 100%;
            max-width: 540px;
            text-align: center;
            margin-bottom: 20px;
            position: relative;
            z-index: 10;
        }

        .hero-avatar-container {
            position: relative;
            display: inline-block;
            margin-bottom: 12px;
        }

        .hero-avatar-ring {
            width: 88px;
            height: 88px;
            border-radius: 50%;
            padding: 3px;
            background: linear-gradient(135deg, #c5a059, #38bdf8, #c5a059);
            box-shadow: 0 0 25px rgba(197, 160, 89, 0.35);
            animation: ringGlow 4s ease-in-out infinite alternate;
        }

        @keyframes ringGlow {
            0% { box-shadow: 0 0 20px rgba(197, 160, 89, 0.3); }
            100% { box-shadow: 0 0 35px rgba(56, 189, 248, 0.45); }
        }

        .hero-avatar-img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            background-size: cover;
            background-position: center;
            background-color: #0b1329;
            border: 2px solid #060913;
        }

        .verified-badge-pill {
            position: absolute;
            bottom: -2px;
            right: -2px;
            background: #0284c7;
            color: #ffffff;
            border: 2px solid #060913;
            border-radius: 50px;
            padding: 2px 7px;
            font-size: 0.68rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 3px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
        }

        .hero-display-name {
            font-size: 1.7rem;
            font-weight: 800;
            margin-bottom: 4px;
            background: linear-gradient(135deg, #ffffff 30%, #e2e8f0 70%, #cbd5e1 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: -0.01em;
        }

        .hero-display-tagline {
            font-size: 0.96rem;
            color: #94a3b8;
            font-weight: 500;
            margin-bottom: 10px;
        }

        .hero-status-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .hero-meta-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 12px;
            border-radius: 50px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.08);
            font-size: 0.78rem;
            color: #cbd5e1;
        }

        .availability-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 12px;
            border-radius: 50px;
            font-size: 0.78rem;
            font-weight: 600;
            background: rgba(34, 197, 94, 0.15);
            color: #4ade80;
            border: 1px solid rgba(34, 197, 94, 0.3);
        }

        .pulse-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: currentColor;
            box-shadow: 0 0 8px currentColor;
            animation: pulse-dot-anim 1.5s infinite;
        }

        @keyframes pulse-dot-anim {
            0% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.4); opacity: 0.5; }
            100% { transform: scale(1); opacity: 1; }
        }

        /* 3D Showcase Stage */
        .cards-container {
            width: 100%;
            max-width: 540px;
            display: flex;
            flex-direction: column;
            align-items: center;
            perspective: 1400px;
            margin-bottom: 22px;
            position: relative;
            z-index: 20;
        }

        .card-stage {
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
            perspective: 1400px;
        }

        .card-pedestal-shadow {
            position: absolute;
            bottom: -18px;
            width: 75%;
            height: 30px;
            background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.85) 0%, rgba(197, 160, 89, 0.2) 40%, transparent 75%);
            border-radius: 50%;
            filter: blur(8px);
            pointer-events: none;
            transition: transform 0.3s ease;
            z-index: 1;
        }

        .cards-wrapper {
            width: 100%;
            max-width: 490px;
            aspect-ratio: 51 / 33;
            position: relative;
            transform-style: preserve-3d;
            transition: transform 0.65s cubic-bezier(0.34, 1.56, 0.64, 1);
            cursor: pointer;
            z-index: 2;
        }

        .cards-wrapper[data-layout="vertical"],
        .cards-wrapper.is-vertical {
            max-width: 320px;
            aspect-ratio: 33 / 51;
        }

        .cards-wrapper.is-flipped {
            transform: rotateY(180deg);
        }

        .business-card {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: var(--card-shadow);
            border: 1px solid rgba(255, 255, 255, 0.12);
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
            background-color: #0b1329;
            transform-style: preserve-3d;
        }

        .card-front {
            transform: rotateY(0deg);
        }

        .card-back {
            transform: rotateY(180deg);
        }

        .card-hologram-sheen {
            position: absolute;
            inset: 0;
            background: linear-gradient(
                115deg,
                transparent 25%,
                rgba(255, 255, 255, 0.18) 45%,
                rgba(197, 160, 89, 0.25) 50%,
                transparent 70%
            );
            background-size: 200% 200%;
            background-position: 50% 50%;
            pointer-events: none;
            z-index: 25;
            mix-blend-mode: overlay;
            opacity: 0.55;
            transition: opacity 0.3s ease;
        }

        .nfc-chip-indicator {
            position: absolute;
            top: 14px;
            left: 16px;
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 0.66rem;
            font-weight: 700;
            color: rgba(255, 255, 255, 0.6);
            letter-spacing: 0.08em;
            z-index: 26;
            pointer-events: none;
            text-transform: uppercase;
        }

        html[dir="rtl"] .nfc-chip-indicator {
            left: auto;
            right: 16px;
        }

        .card-background-layer {
            position: absolute;
            inset: 0;
            background-size: cover;
            background-position: center;
            z-index: 1;
        }

        .card-gradient-layer {
            position: absolute;
            inset: 0;
            z-index: 2;
        }

        .card-content {
            position: relative;
            z-index: 10;
            width: 100%;
            height: 100%;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 18px;
        }

        .draggable-element {
            position: absolute;
            display: flex;
            align-items: center;
            justify-content: center;
            box-sizing: border-box;
        }

        /* Showcase Floating Controls */
        .showcase-controls-dock {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-top: 16px;
            z-index: 30;
        }

        .stage-pill-btn {
            background: rgba(13, 19, 33, 0.75);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #e2e8f0;
            padding: 8px 18px;
            border-radius: 50px;
            font-size: 0.82rem;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
            transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
            font-family: inherit;
        }

        .stage-pill-btn:hover {
            border-color: rgba(197, 160, 89, 0.5);
            background: rgba(30, 41, 59, 0.9);
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.6), 0 0 15px rgba(197, 160, 89, 0.2);
        }

        .stage-pill-btn:active {
            transform: scale(0.96);
        }

        /* Minimalist Tactile Action Hub */
        .luxury-action-hub {
            width: 100%;
            max-width: 520px;
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            margin-top: 8px;
            margin-bottom: 25px;
            z-index: 10;
        }

        @media (max-width: 480px) {
            .luxury-action-hub {
                grid-template-columns: 1fr;
                gap: 10px;
            }
        }

        .action-tile-btn {
            background: rgba(13, 19, 33, 0.78);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 20px;
            padding: 14px 16px;
            display: flex;
            align-items: center;
            gap: 14px;
            cursor: pointer;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
            transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
            text-align: right;
            color: #f8fafc;
            font-family: inherit;
            position: relative;
            overflow: hidden;
        }

        html[dir="ltr"] .action-tile-btn {
            text-align: left;
        }

        .action-tile-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(197, 160, 89, 0.4), transparent);
        }

        .action-tile-btn:hover {
            border-color: rgba(197, 160, 89, 0.4);
            background: rgba(22, 31, 51, 0.9);
            transform: translateY(-3px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.6), 0 0 20px rgba(197, 160, 89, 0.15);
        }

        .action-tile-btn:active {
            transform: scale(0.97);
        }

        .tile-icon-box {
            width: 44px;
            height: 44px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            flex-shrink: 0;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .tile-blue { background: rgba(59, 130, 246, 0.18); color: #60a5fa; }
        .tile-purple { background: rgba(168, 85, 247, 0.18); color: #c084fc; }
        .tile-emerald { background: rgba(16, 185, 129, 0.18); color: #34d399; }
        .tile-gold { background: rgba(197, 160, 89, 0.18); color: #e6ca85; }
        .tile-pink { background: rgba(236, 72, 153, 0.18); color: #f472b6; }
        .tile-amber { background: rgba(245, 158, 11, 0.18); color: #fbbf24; }

        .tile-info {
            display: flex;
            flex-direction: column;
            gap: 2px;
            flex: 1;
            min-width: 0;
        }

        .tile-title {
            font-size: 0.92rem;
            font-weight: 700;
            color: #f1f5f9;
        }

        .tile-sub {
            font-size: 0.74rem;
            color: #94a3b8;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .tile-arrow {
            color: #64748b;
            font-size: 0.8rem;
            transition: transform 0.2s ease, color 0.2s ease;
        }

        html[dir="ltr"] .tile-arrow {
            transform: rotate(180deg);
        }

        .action-tile-btn:hover .tile-arrow {
            color: #c5a059;
            transform: translateX(-4px);
        }

        html[dir="ltr"] .action-tile-btn:hover .tile-arrow {
            transform: rotate(180deg) translateX(-4px);
        }

        /* Pop-out Luxury Sheets */
        .luxury-sheet-backdrop {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            z-index: 1000;
            display: flex;
            align-items: flex-end;
            justify-content: center;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.3s ease, visibility 0.3s ease;
        }

        .luxury-sheet-backdrop.active {
            opacity: 1;
            visibility: visible;
        }

        .luxury-sheet {
            width: 100%;
            max-width: 520px;
            background: rgba(13, 19, 33, 0.95);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-bottom: none;
            border-radius: 30px 30px 0 0;
            padding: 24px 20px 40px 20px;
            box-shadow: 0 -20px 60px rgba(0, 0, 0, 0.8);
            transform: translateY(100%);
            transition: transform 0.35s cubic-bezier(0.34, 1.2, 0.64, 1);
            max-height: 85vh;
            overflow-y: auto;
        }

        .luxury-sheet-backdrop.active .luxury-sheet {
            transform: translateY(0);
        }

        .sheet-handle {
            width: 44px;
            height: 5px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 10px;
            margin: 0 auto 18px auto;
        }

        .sheet-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
            padding-bottom: 14px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .sheet-title-group {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .sheet-title-group h3 {
            font-size: 1.15rem;
            font-weight: 700;
            color: #ffffff;
        }

        .sheet-close-btn {
            background: rgba(255, 255, 255, 0.08);
            border: none;
            color: #94a3b8;
            width: 34px;
            height: 34px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 1.1rem;
            transition: all 0.2s ease;
        }

        .sheet-close-btn:hover {
            background: rgba(239, 68, 68, 0.2);
            color: #ef4444;
        }

        /* Items inside sheets */
        .sheet-item-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.07);
            border-radius: 16px;
            padding: 12px 14px;
            margin-bottom: 10px;
            transition: all 0.2s ease;
        }

        .sheet-item-row:hover {
            background: rgba(255, 255, 255, 0.07);
            border-color: rgba(197, 160, 89, 0.3);
        }

        .sheet-item-main {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: #f1f5f9;
            flex: 1;
            min-width: 0;
        }

        .sheet-item-icon {
            width: 38px;
            height: 38px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            flex-shrink: 0;
        }

        .sheet-item-text {
            display: flex;
            flex-direction: column;
            gap: 2px;
            min-width: 0;
        }

        .sheet-item-label {
            font-size: 0.88rem;
            font-weight: 700;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .sheet-item-val {
            font-size: 0.74rem;
            color: #94a3b8;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .sheet-copy-btn {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #94a3b8;
            width: 34px;
            height: 34px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
            margin-inline-start: 8px;
        }

        .sheet-copy-btn:hover {
            background: rgba(197, 160, 89, 0.2);
            color: #c5a059;
            border-color: rgba(197, 160, 89, 0.4);
        }

        /* Social Grid in Sheet */
        .social-sheet-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
        }

        .social-sheet-card {
            display: flex;
            align-items: center;
            gap: 12px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.07);
            border-radius: 16px;
            padding: 12px;
            text-decoration: none;
            color: #f1f5f9;
            transition: all 0.2s ease;
        }

        .social-sheet-card:hover {
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(197, 160, 89, 0.35);
            transform: translateY(-2px);
        }

        /* Floating Apple Capsule Dock */
        .sticky-footer {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            width: calc(100% - 32px);
            max-width: 480px;
            background: rgba(13, 19, 33, 0.85);
            backdrop-filter: blur(28px);
            -webkit-backdrop-filter: blur(28px);
            border: 1px solid rgba(255, 255, 255, 0.14);
            border-radius: 50px;
            padding: 8px 12px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8), 0 0 30px rgba(197, 160, 89, 0.2);
            z-index: 500;
        }

        .footer-primary-btn {
            flex: 1.4;
            background: var(--gold-gradient);
            color: #060913;
            border: none;
            border-radius: 50px;
            padding: 12px 18px;
            font-size: 0.95rem;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            cursor: pointer;
            box-shadow: 0 6px 20px rgba(197, 160, 89, 0.4);
            transition: all 0.25s ease;
            position: relative;
            overflow: hidden;
            font-family: inherit;
        }

        .footer-primary-btn::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(
                60deg,
                transparent 30%,
                rgba(255, 255, 255, 0.6) 50%,
                transparent 70%
            );
            transform: rotate(25deg);
            animation: shimmerSweep 3.5s infinite;
        }

        @keyframes shimmerSweep {
            0% { transform: translateX(-100%) rotate(25deg); }
            40%, 100% { transform: translateX(100%) rotate(25deg); }
        }

        .footer-primary-btn:hover {
            transform: scale(1.02);
            filter: brightness(1.1);
        }

        .footer-primary-btn:active {
            transform: scale(0.97);
        }

        .footer-secondary-btn {
            flex: 1;
            background: rgba(16, 185, 129, 0.15);
            color: #34d399;
            border: 1px solid rgba(16, 185, 129, 0.35);
            border-radius: 50px;
            padding: 12px 14px;
            font-size: 0.88rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            cursor: pointer;
            transition: all 0.2s ease;
            font-family: inherit;
        }

        .footer-secondary-btn:hover {
            background: rgba(16, 185, 129, 0.25);
            border-color: rgba(16, 185, 129, 0.5);
            transform: scale(1.02);
        }

        .footer-secondary-btn:active {
            transform: scale(0.97);
        }

        .footer-icon-btn {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #cbd5e1;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
            flex-shrink: 0;
            font-size: 1rem;
        }

        .footer-icon-btn:hover {
            background: rgba(197, 160, 89, 0.25);
            color: #ffffff;
            border-color: rgba(197, 160, 89, 0.4);
            transform: scale(1.05);
        }

        /* Standard Modals (Exchange, QR, Story, Fullscreen) */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            z-index: 1100;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
            padding: 16px;
        }

        .modal-overlay.show {
            opacity: 1;
            visibility: visible;
        }

        .modal-card {
            background: rgba(13, 19, 33, 0.95);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 26px;
            padding: 24px;
            width: 100%;
            max-width: 440px;
            box-shadow: 0 30px 70px rgba(0, 0, 0, 0.9);
            transform: scale(0.95);
            transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            position: relative;
        }

        .modal-overlay.show .modal-card {
            transform: scale(1);
        }

        .modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 18px;
            padding-bottom: 12px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .modal-header h3 {
            font-size: 1.15rem;
            color: #ffffff;
            font-weight: 700;
        }

        .close-btn {
            background: rgba(255, 255, 255, 0.08);
            border: none;
            color: #94a3b8;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s;
        }

        .close-btn:hover {
            background: rgba(239, 68, 68, 0.2);
            color: #ef4444;
        }

        /* Form Inputs */
        .form-group {
            margin-bottom: 14px;
            text-align: right;
        }

        html[dir="ltr"] .form-group {
            text-align: left;
        }

        .form-group label {
            display: block;
            font-size: 0.8rem;
            color: #94a3b8;
            margin-bottom: 6px;
            font-weight: 600;
        }

        .form-input {
            width: 100%;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 10px 14px;
            color: #ffffff;
            font-size: 0.92rem;
            font-family: inherit;
            outline: none;
            transition: border-color 0.2s;
        }

        .form-input:focus {
            border-color: var(--gold-primary);
            background: rgba(255, 255, 255, 0.08);
        }

        /* Toast Container */
        #toast-container {
            position: fixed;
            bottom: 90px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 2000;
            display: flex;
            flex-direction: column;
            gap: 8px;
            pointer-events: none;
            width: auto;
            max-width: 90vw;
        }

        .custom-toast {
            background: rgba(13, 19, 33, 0.95);
            border: 1px solid rgba(197, 160, 89, 0.4);
            backdrop-filter: blur(20px);
            color: #ffffff;
            padding: 10px 20px;
            border-radius: 50px;
            font-size: 0.86rem;
            font-weight: 700;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
            display: flex;
            align-items: center;
            gap: 10px;
            opacity: 0;
            transform: translateY(15px);
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .custom-toast.show {
            opacity: 1;
            transform: translateY(0);
        }

        .toast-success { border-color: #10b981; }
        .toast-error { border-color: #ef4444; }
        .toast-info { border-color: #c5a059; }

        /* Story Generator Canvas */
        #ejs-story-canvas {
            width: 100%;
            max-width: 320px;
            aspect-ratio: 9 / 16;
            border-radius: 18px;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.6);
            display: block;
            margin: 0 auto 16px auto;
        }

        .story-theme-pills {
            display: flex;
            gap: 8px;
            overflow-x: auto;
            padding-bottom: 8px;
            margin-bottom: 14px;
        }

        .theme-pill-btn {
            padding: 6px 14px;
            border-radius: 50px;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #cbd5e1;
            font-size: 0.78rem;
            cursor: pointer;
            white-space: nowrap;
            transition: all 0.2s;
            font-family: inherit;
        }

        .theme-pill-btn.active {
            background: var(--gold-gradient);
            color: #060913;
            border-color: transparent;
            font-weight: 700;
        }

        /* Fullscreen 3D Modal */
        #fullscreen-modal .modal-card {
            max-width: 600px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        #fullscreen-card-clone {
            width: 100%;
            max-width: 480px;
            margin: 20px auto;
        }
    </style>
</head>

<body>
    <!-- Ambient Aurora Mesh Orbs -->
    <div class="ambient-aurora-container">
        <div class="aurora-orb aurora-gold"></div>
        <div class="aurora-orb aurora-blue"></div>
    </div>

    <!-- Top Navigation Bar -->
    <header class="viewer-top-bar" aria-label="شريط التحكم">
        <a href="/nfc/" class="top-bar-brand" title="MC PRIME NFC">
            <img src="/nfc/mc-prime-nfc.png" alt="MC PRIME">
            <span>MC PRIME</span>
        </a>
        <div class="top-bar-actions">
            <button class="top-icon-btn" id="ejs-lang-toggle" aria-label="تبديل اللغة">
                <i class="fas fa-globe"></i>
                <span id="lang-btn-text"><%= (typeof initialLang !== 'undefined' && initialLang === 'en') ? 'عربي' : 'EN' %></span>
            </button>
            <button class="top-icon-btn" id="top-share-btn" aria-label="مشاركة البطاقة">
                <i class="fas fa-share-alt"></i>
            </button>
        </div>
    </header>

    <%
    // Safe extract of server values
    const safeInputs = typeof inputs !== 'undefined' && inputs ? inputs : {};
    const safeImages = typeof images !== 'undefined' && images ? images : {};
    const safeDynamic = typeof dynamic !== 'undefined' && dynamic ? dynamic : {};
    const safePositions = typeof positions !== 'undefined' && positions ? positions : {};
    const safePlacements = typeof placements !== 'undefined' && placements ? placements : {};
    const safeVisibilities = typeof visibilities !== 'undefined' && visibilities ? visibilities : {};
    const cardLayout = typeof layout !== 'undefined' && layout ? layout : 'classic';

    const cardBio = safeInputs['input-bio'] || '';
    const cardComp = safeInputs['input-company'] || '';
    const avail = safeInputs['toggle-availability'] !== false;

    function isFront(key) {
        return (safePlacements[key] || 'front') === 'front';
    }

    function getStyle(id) {
        const pos = safePositions[id] || { x: 0, y: 0 };
        return 'transform: translate(' + (Number(pos.x) || 0) + 'px, ' + (Number(pos.y) || 0) + 'px);';
    }

    function getTextStyle(key) {
        let s = '';
        if (safeInputs[key + '-letter-spacing']) s += 'letter-spacing: ' + safeInputs[key + '-letter-spacing'] + 'px; ';
        if (safeInputs[key + '-line-height']) s += 'line-height: ' + safeInputs[key + '-line-height'] + '; ';
        if (safeInputs[key + '-uppercase']) s += 'text-transform: uppercase; ';
        if (safeInputs[key + '-glow']) s += 'text-shadow: 0 0 10px ' + (safeInputs[key + '-color'] || '#fff') + '; ';
        return s;
    }

    function getFilterStyle(key) {
        const f = [];
        if (safeInputs[key + '-filter-grayscale']) f.push('grayscale(' + safeInputs[key + '-filter-grayscale'] + '%)');
        if (safeInputs[key + '-filter-sepia']) f.push('sepia(' + safeInputs[key + '-filter-sepia'] + '%)');
        if (safeInputs[key + '-filter-blur']) f.push('blur(' + safeInputs[key + '-filter-blur'] + 'px)');
        if (safeInputs[key + '-filter-invert']) f.push('invert(' + safeInputs[key + '-filter-invert'] + '%)');
        if (safeInputs[key + '-filter-brightness']) f.push('brightness(' + safeInputs[key + '-filter-brightness'] + '%)');
        if (safeInputs[key + '-filter-contrast']) f.push('contrast(' + safeInputs[key + '-filter-contrast'] + '%)');
        return f.length ? 'filter: ' + f.join(' ') + ';' : '';
    }

    function getBtnStyle(type) {
        const shape = safeInputs[type + '-style'] || 'solid';
        const bg = safeInputs[type + '-bg-color'] || '#3b82f6';
        const text = safeInputs[type + '-text-color'] || '#ffffff';
        const rad = safeInputs[type + '-radius'] || 50;
        let s = 'border-radius: ' + rad + 'px !important; ';
        if (shape === 'outline') {
            s += 'background-color: transparent !important; color: ' + bg + ' !important; border: 2px solid ' + bg + ' !important; ';
        } else if (shape === 'glass') {
            s += 'background-color: rgba(255, 255, 255, 0.2) !important; backdrop-filter: blur(10px) !important; border: 1px solid rgba(255, 255, 255, 0.3) !important; color: ' + text + ' !important; ';
        } else {
            s += 'background-color: ' + bg + ' !important; color: ' + text + ' !important; border: 2px solid transparent !important; ';
        }
        return s;
    }

    function getDynamicPositionStyle(item) {
        const pos = item && item.position ? item.position : {};
        const x = Number.isFinite(Number(pos.x)) ? Number(pos.x) : 0;
        const y = Number.isFinite(Number(pos.y)) ? Number(pos.y) : 0;
        return 'transform: translate(' + x + 'px, ' + y + 'px);';
    }

    const platforms = {
        whatsapp: { icon: 'fab fa-whatsapp', color: '#25d366', prefix: 'https://wa.me/' },
        email: { icon: 'fas fa-envelope', color: '#ea4335', prefix: 'mailto:' },
        website: { icon: 'fas fa-globe', color: '#38bdf8', prefix: '' },
        facebook: { icon: 'fab fa-facebook-f', color: '#1877f2', prefix: '' },
        linkedin: { icon: 'fab fa-linkedin-in', color: '#0a66c2', prefix: '' },
        instagram: { icon: 'fab fa-instagram', color: '#e1306c', prefix: '' },
        x: { icon: 'fab fa-x-twitter', color: '#e2e8f0', prefix: '' },
        telegram: { icon: 'fab fa-telegram', color: '#229ed9', prefix: '' },
        tiktok: { icon: 'fab fa-tiktok', color: '#ff0050', prefix: '' },
        snapchat: { icon: 'fab fa-snapchat', color: '#fffc00', prefix: '' },
        youtube: { icon: 'fab fa-youtube', color: '#ff0000', prefix: '' },
        pinterest: { icon: 'fab fa-pinterest', color: '#bd081c', prefix: '' }
    };

    const allSocials = [];
    if (safeDynamic.staticSocial) {
        Object.entries(safeDynamic.staticSocial).forEach(([key, data]) => {
            if (data && data.value) allSocials.push({ ...data, type: key, isStatic: true });
        });
    }
    if (safeDynamic.social) {
        safeDynamic.social.forEach(item => {
            if (item && item.value) allSocials.push({ ...item, type: item.platform, isStatic: false });
        });
    }

    const mainPhone = (safeDynamic.phones && safeDynamic.phones[0]) ? String(safeDynamic.phones[0].value).replace(/\D/g, '') : '';
    const mainEmail = (safeDynamic.staticSocial && safeDynamic.staticSocial.email) ? safeDynamic.staticSocial.email.value : ((allSocials.find(s => s.type === 'email')) ? allSocials.find(s => s.type === 'email').value : '');
    const mainWhatsapp = (safeDynamic.staticSocial && safeDynamic.staticSocial.whatsapp) ? safeDynamic.staticSocial.whatsapp.value : ((allSocials.find(s => s.type === 'whatsapp')) ? allSocials.find(s => s.type === 'whatsapp').value : '');
    const cleanWa = mainWhatsapp ? String(mainWhatsapp).replace(/\D/g, '') : mainPhone;
    const waGreeting = encodeURIComponent('مرحباً ' + name + '، تشرفت بالاطلاع على بطاقة عملك الرقمية.');

    const followMethods = allSocials.filter(s => !['whatsapp', 'email', 'phone'].includes(s.type));
    %>

    <!-- Executive Persona Header -->
    <section class="executive-hero-header" aria-label="الملف التعريفي">
        <div class="hero-avatar-container">
            <div class="hero-avatar-ring">
                <% if (typeof heroPhoto !== 'undefined' && heroPhoto) { %>
                    <div class="hero-avatar-img" style="background-image: url('<%= heroPhoto %>');"></div>
                <% } else if (safeImages.photo) { %>
                    <div class="hero-avatar-img" style="background-image: url('<%= safeImages.photo %>');"></div>
                <% } else { %>
                    <div class="hero-avatar-img" style="display:flex;align-items:center;justify-content:center;color:#c5a059;font-size:2rem;font-weight:800;">
                        <%= (name || 'MC').charAt(0) %>
                    </div>
                <% } %>
            </div>
            <span class="verified-badge-pill" title="حساب موثق">
                <i class="fas fa-check-circle"></i>
                <span class="i18n-verified"><%= (typeof initialLang !== 'undefined' && initialLang === 'en') ? 'Verified' : 'موثّق' %></span>
            </span>
        </div>
        <h1 class="hero-display-name"><%= name %></h1>
        <% if (tagline) { %>
            <p class="hero-display-tagline"><%= tagline %></p>
        <% } %>
        <div class="hero-status-row">
            <% if (cardComp) { %>
                <div class="hero-meta-pill">
                    <i class="fas fa-building" style="color:var(--gold-primary);"></i>
                    <span><%= cardComp %></span>
                </div>
            <% } %>
            <div class="availability-badge">
                <span class="pulse-dot"></span>
                <span class="i18n-status-text"><%= (typeof initialLang !== 'undefined' && initialLang === 'en') ? 'Available for Business' : 'متاح للأعمال والاستشارات' %></span>
            </div>
        </div>
    </section>

    <!-- 3D Centerpiece Showcase Stage -->
    <div class="cards-container">
        <div class="card-stage" id="card-stage">
            <!-- Reflection Shadow Pedestal -->
            <div class="card-pedestal-shadow" id="card-shadow-reflect"></div>

            <!-- Double-Sided 3D Card -->
            <div class="cards-wrapper" id="card" data-layout="<%= cardLayout %>">

                <!-- === Front Face === -->
                <div class="business-card card-front">
                    <div class="card-hologram-sheen"></div>
                    <div class="nfc-chip-indicator">
                        <i class="fas fa-wifi"></i>
                        <span>NFC SMART CARD</span>
                    </div>

                    <div class="card-background-layer"
                        style="background-image: url('<%= safeImages.front || '' %>'); display: <%= safeImages.front ? 'block' : 'none' %>;">
                    </div>
                    <div class="card-gradient-layer"
                        style="background: linear-gradient(135deg, <%= safeInputs['front-bg-start'] || '#2a3d54' %>, <%= safeInputs['front-bg-end'] || '#223246' %>); opacity: <%= safeImages.front ? (safeInputs['front-bg-opacity'] || 0.3) : 1 %>;">
                    </div>

                    <div class="card-content">
                        <% if (isFront('logo') && safeInputs['input-logo']) { %>
                            <img id="card-logo" src="<%= safeInputs['input-logo'] %>" class="draggable-element"
                                style="<%= getStyle('card-logo') %>; max-width: <%= safeInputs['logo-size'] || 20 %>%; opacity: <%= safeInputs['logo-opacity'] || 1 %>; <%= getFilterStyle('logo') %>">
                        <% } %>

                        <% if (isFront('photo') && safeImages.photo) { %>
                            <div id="card-photo" class="draggable-element"
                                style="<%= getStyle('card-personal-photo-wrapper') %>; width: <%= safeInputs['photo-size'] || 25 %>%; aspect-ratio: 1/1; border-radius: <%= safeInputs['photo-shape'] === 'circle' ? '50%' : '8px' %>; border: <%= safeInputs['photo-border-width'] || 2 %>px solid <%= safeInputs['photo-border-color'] || '#ffffff' %>; background-image: url('<%= safeImages.photo %>'); background-size: cover; background-position: center; <%= getFilterStyle('photo') %> <%= safeInputs['photo-glass-effect'] ? 'mix-blend-mode: screen; opacity: 0.9;' : '' %>">
                            </div>
                        <% } %>

                        <% if (isFront('name')) { %>
                            <h1 id="card-name" class="draggable-element"
                                style="<%= getStyle('card-name') %>; color: <%= safeInputs['name-color'] || '#ffffff' %>; font-size: <%= safeInputs['name-font-size'] || 22 %>px; font-family: <%= safeInputs['name-font'] || 'Tajawal, sans-serif' %>; <%= getTextStyle('name') %>">
                                <%= safeInputs['input-name'] || name %>
                            </h1>
                        <% } %>

                        <% if (isFront('tagline') && safeInputs['input-tagline']) { %>
                            <h2 id="card-tagline" class="draggable-element"
                                style="<%= getStyle('card-tagline') %>; color: <%= safeInputs['tagline-color'] || '#c5a059' %>; font-size: <%= safeInputs['tagline-font-size'] || 14 %>px; font-family: <%= safeInputs['tagline-font'] || 'Tajawal, sans-serif' %>; <%= getTextStyle('tagline') %>">
                                <%= safeInputs['input-tagline'] %>
                            </h2>
                        <% } %>

                        <% if (isFront('qr') && safeInputs['qr-source'] !== 'none') { %>
                            <div class="draggable-element qr-wrapper"
                                style="<%= getStyle('qr-code-wrapper') %>; width: <%= safeInputs['qr-size'] || 25 %>%;">
                                <img src="<%= safeImages.qrCode || ('https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=' + encodeURIComponent(pageUrl)) %>" alt="QR Code" style="width:100%;height:auto;border-radius:4px;background:#fff;padding:3px;">
                            </div>
                        <% } %>

                        <% if (safeDynamic.phones) { safeDynamic.phones.forEach(phone => {
                            if (phone.placement === 'front' && phone.value) { %>
                            <div class="draggable-element" style="<%= getDynamicPositionStyle(phone) %>">
                                <a href="tel:<%= phone.value %>" class="phone-btn" style="<%= getBtnStyle('phone-btn') %> font-size: <%= safeInputs['phone-btn-font-size'] || 12 %>px; font-family: <%= safeInputs['phone-btn-font'] || 'inherit' %>; padding: 6px 12px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                                    <i class="fas fa-phone-alt"></i>
                                    <span><%= phone.value %></span>
                                </a>
                            </div>
                        <% }}); } %>
                    </div>
                </div>

                <!-- === Back Face === -->
                <div class="business-card card-back">
                    <div class="card-hologram-sheen"></div>
                    <div class="card-background-layer"
                        style="background-image: url('<%= safeImages.back || '' %>'); display: <%= safeImages.back ? 'block' : 'none' %>;">
                    </div>
                    <div class="card-gradient-layer"
                        style="background: linear-gradient(135deg, <%= safeInputs['back-bg-start'] || '#2a3d54' %>, <%= safeInputs['back-bg-end'] || '#223246' %>); opacity: <%= safeImages.back ? (safeInputs['back-bg-opacity'] || 0.3) : 1 %>;">
                    </div>

                    <div class="card-content">
                        <% if (!isFront('logo') && safeInputs['input-logo']) { %>
                            <img id="card-logo" src="<%= safeInputs['input-logo'] %>" class="draggable-element"
                                style="<%= getStyle('card-logo') %>; max-width: <%= safeInputs['logo-size'] || 20 %>%; opacity: <%= safeInputs['logo-opacity'] || 1 %>; <%= getFilterStyle('logo') %>">
                        <% } %>

                        <% if (!isFront('photo') && safeImages.photo) { %>
                            <div id="card-photo" class="draggable-element"
                                style="<%= getStyle('card-personal-photo-wrapper') %>; width: <%= safeInputs['photo-size'] || 25 %>%; aspect-ratio: 1/1; border-radius: <%= safeInputs['photo-shape'] === 'circle' ? '50%' : '8px' %>; border: <%= safeInputs['photo-border-width'] || 2 %>px solid <%= safeInputs['photo-border-color'] || '#ffffff' %>; background-image: url('<%= safeImages.photo %>'); background-size: cover; background-position: center; <%= getFilterStyle('photo') %> <%= safeInputs['photo-glass-effect'] ? 'mix-blend-mode: screen; opacity: 0.9;' : '' %>">
                            </div>
                        <% } %>

                        <% if (!isFront('name')) { %>
                            <h1 id="card-name" class="draggable-element"
                                style="<%= getStyle('card-name') %>; color: <%= safeInputs['name-color'] || '#ffffff' %>; font-size: <%= safeInputs['name-font-size'] || 22 %>px; font-family: <%= safeInputs['name-font'] || 'Tajawal, sans-serif' %>; <%= getTextStyle('name') %>">
                                <%= safeInputs['input-name'] || name %>
                            </h1>
                        <% } %>

                        <% if (!isFront('tagline') && safeInputs['input-tagline']) { %>
                            <h2 id="card-tagline" class="draggable-element"
                                style="<%= getStyle('card-tagline') %>; color: <%= safeInputs['tagline-color'] || '#c5a059' %>; font-size: <%= safeInputs['tagline-font-size'] || 14 %>px; font-family: <%= safeInputs['tagline-font'] || 'Tajawal, sans-serif' %>; <%= getTextStyle('tagline') %>">
                                <%= safeInputs['input-tagline'] %>
                            </h2>
                        <% } %>

                        <% if (!isFront('qr') && safeInputs['qr-source'] !== 'none') { %>
                            <div class="draggable-element qr-wrapper"
                                style="<%= getStyle('qr-code-wrapper') %>; width: <%= safeInputs['qr-size'] || 25 %>%;">
                                <img src="<%= safeImages.qrCode || ('https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=' + encodeURIComponent(pageUrl)) %>" alt="QR Code" style="width:100%;height:auto;border-radius:4px;background:#fff;padding:3px;">
                            </div>
                        <% } %>

                        <% if (safeDynamic.phones) { safeDynamic.phones.forEach(phone => {
                            if (phone.placement === 'back' && phone.value) { %>
                            <div class="draggable-element" style="<%= getDynamicPositionStyle(phone) %>">
                                <a href="tel:<%= phone.value %>" class="phone-btn" style="<%= getBtnStyle('phone-btn') %> font-size: <%= safeInputs['phone-btn-font-size'] || 12 %>px; font-family: <%= safeInputs['phone-btn-font'] || 'inherit' %>; padding: 6px 12px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                                    <i class="fas fa-phone-alt"></i>
                                    <span><%= phone.value %></span>
                                </a>
                            </div>
                        <% }}); } %>

                        <% allSocials.forEach(item => {
                            const platform = platforms[item.type] || { icon: 'fas fa-link', color: '#c5a059', prefix: '' };
                            let url = item.value;
                            if (item.type === 'email' && !url.startsWith('mailto:')) url = 'mailto:' + url;
                            else if (item.type === 'whatsapp') url = 'https://wa.me/' + url.replace(/\D/g, '');
                            else if (!url.startsWith('http')) url = 'https://' + url;

                            const itemPlacement = item.placement || 'back';
                            if (itemPlacement === 'back') {
                        %>
                            <div class="draggable-element" style="<%= getDynamicPositionStyle(item) %>">
                                <a href="<%= url %>" target="_blank" rel="noopener noreferrer" class="social-btn" style="<%= getBtnStyle('back-buttons') %> font-size: <%= safeInputs['back-buttons-size'] || 11 %>px; padding: 5px 10px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                                    <i class="<%= platform.icon %>"></i>
                                    <span><%= item.value %></span>
                                </a>
                            </div>
                        <% } }); %>
                    </div>
                </div>

            </div><!-- /cards-wrapper -->
        </div><!-- /card-stage -->

        <!-- Showcase Floating Controls Under Card -->
        <div class="showcase-controls-dock">
            <button class="stage-pill-btn" id="stage-flip-btn" aria-label="تقليب البطاقة">
                <i class="fas fa-sync-alt"></i>
                <span class="i18n-flip-btn"><%= (typeof initialLang !== 'undefined' && initialLang === 'en') ? 'Flip 3D' : 'تقليب 3D' %></span>
            </button>
            <button class="stage-pill-btn" id="stage-fullscreen-btn" aria-label="فحص ثلاثي الأبعاد">
                <i class="fas fa-expand"></i>
                <span class="i18n-inspect-btn"><%= (typeof initialLang !== 'undefined' && initialLang === 'en') ? 'Inspect 3D' : 'فحص ثلاثي الأبعاد' %></span>
            </button>
            <button class="stage-pill-btn" id="stage-download-png-btn" aria-label="حفظ صورة البطاقة">
                <i class="fas fa-arrow-down"></i>
                <span class="i18n-hd-btn"><%= (typeof initialLang !== 'undefined' && initialLang === 'en') ? 'HD Card' : 'صورة HD' %></span>
            </button>
        </div>
