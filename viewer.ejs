            <div class="modal-header">
                <h3 id="qr-modal-title" class="i18n-qr-title"><%= (typeof initialLang !== 'undefined' && initialLang === 'en') ? 'Smart QR Code' : 'رمز QR الذكي' %></h3>
                <button class="close-btn" id="ejs-qr-close-btn" aria-label="إغلاق">&times;</button>
