{
  "name": "digital-card-server",
  "version": "2.1.0",
  "description": "Enhanced Server for the Digital Business Card Editor with improved security and performance",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "eslint server.js auth-middleware.js email-service.js routes utils scripts test --ext .js --max-warnings=100",
    "format": "prettier --write \"**/*.js\"",
    "test": "jest",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "build:assets": "node minify-assets.js",
    "build:sw": "terser sw.original.js -o sw.js --compress --mangle",
    "check:assets": "node scripts/check-generated-assets.js",
    "package:static": "node scripts/package-static-site.js",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=high",
    "audit:editor": "node scripts/audit-editor-markup.js",
    "audit:editor:strict": "node scripts/audit-editor-markup.js --strict"
  },
  "keywords": [
    "nfc",
    "business-card",
    "digital-card",
    "nodejs",
    "express",
    "mongodb",
    "mc-prime"
  ],
  "author": "MC PRIME",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cloudinary": "^2.9.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dompurify": "^3.4.12",
    "dotenv": "^17.2.2",
    "ejs": "^5.0.2",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.1",
    "express-useragent": "^2.0.2",
    "express-validator": "^7.3.1",
    "file-type": "^22.0.1",
    "helmet": "^7.1.0",
    "jsdom": "^26.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.19.0",
    "multer": "^2.2.0",
    "nanoid": "^3.3.11",
    "resend": "^6.18.1",
    "sharp": "^0.35.3",
    "validator": "^13.15.26",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.2.0",
    "clean-css": "^5.3.3",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "nodemon": "^3.1.14",
    "playwright": "^1.58.2",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "terser": "^5.47.1"
  },
  "overrides": {
    "brace-expansion": "^1.1.17",
    "form-data": "^4.0.6",
    "js-yaml": "^4.3.0"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elfox14/nfc.git"
  },
  "bugs": {
    "url": "https://github.com/elfox14/nfc/issues"
  },
  "homepage": "https://www.mcprim.com/nfc/"
}
